/// Per-employee salary structure. Basic is the primary input; HRA /
/// Conveyance / Medical / Special are stored as % of Basic and default
/// to the company-wide template (40 / 20 / 25 / 15). Gross is therefore
/// always derivable as Basic × (1 + sum(pcts)/100) — by default 2×.
/// PT defaults to the Kerala slab for the gross at insert-time; HR can
/// override.
model HrSalaryStructure {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime @db.Date
  /// Basic salary (₹ / month) — primary input. Everything else derives.
  basic           Decimal  @db.Decimal(12, 2)
  hraPct          Decimal  @db.Decimal(5, 2) @default(40)
  conveyancePct   Decimal  @db.Decimal(5, 2) @default(20)
  medicalPct      Decimal  @db.Decimal(5, 2) @default(25)
  specialPct      Decimal  @db.Decimal(5, 2) @default(15)
  esiApplicable   Boolean  @default(true)
  pfApplicable    Boolean  @default(true)
  /// Override Kerala PT slab if needed. Default 125 (₹125/mo slab).
  professionalTax Decimal  @db.Decimal(8, 2) @default(125)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId])
  @@index([effectiveFrom])
}

model HrLeavePolicy {
  id                  String   @id @default(cuid())
  name                String   @unique
  monthlyAccrual      Decimal  @db.Decimal(4, 2) @default(1)
  annualEntitlement   Decimal  @db.Decimal(5, 2) @default(12)
  carryForward        Boolean  @default(true)
  carryForwardCap     Decimal  @db.Decimal(5, 2) @default(0)
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HrLeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year         Int
  opening      Decimal  @db.Decimal(5, 2) @default(0)
  accrued      Decimal  @db.Decimal(5, 2) @default(0)
  used         Decimal  @db.Decimal(5, 2) @default(0)
  balance      Decimal  @db.Decimal(5, 2) @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([employeeId, year])
  @@index([year])
}

model HrLeaveRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  days         Decimal  @db.Decimal(5, 2)
  leaveType    String   @default("CL")
  reason       String?
  status       String   @default("pending")
  reviewedById String?
  reviewedBy   User?    @relation("HrLeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, fromDate])
  @@index([status])
}

// (HrHoliday was unified into the shared `Holiday` model — both Marketing
//  and HR now read/write the same table.)

model HrAttendanceUpload {
  id          String   @id @default(cuid())
  filename    String?
  monthKey    String
  rowCount    Int      @default(0)
  uploadedById String?
  uploadedBy  User?    @relation("HrUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt  DateTime @default(now())
  notes       String?
  days        HrAttendanceDay[]

  @@index([monthKey])
  @@index([uploadedAt])
}

model HrAttendanceDay {
  id           String   @id @default(cuid())
  uploadId     String
  upload       HrAttendanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  shiftCode    String?  // "G", "X", "C" etc from biometric report
  inTime       String?
  outTime      String?
  /// Minutes worked excluding OT (i.e. Work+OT - OT in the source file).
  workMinutes  Int?
  breakMinutes Int?
  otMinutes    Int?
  lateMinutes  Int?
  earlyOutMinutes Int?
  /// Normalised status: P | A | WO | HL | LV | HD. HD is derived when
  /// status=P but workMinutes is < ~4h (per the half-day rule).
  /// HR can later override A → LV (paid CL) or LV → A (LOP) from the
  /// /hr/leave-review page; the original biometric value is preserved
  /// in `rawStatus` for audit.
  status       String
  /// Free-text remark from the biometric report (e.g. "LT-EO", "MIS-LT-OT").
  remark       String?
  rawName      String?
  /// Original status from the biometric upload, before any HR override.
  /// Null on rows imported before this column existed (treat as same as
  /// `status` in that case).
  rawStatus    String?
  /// HR's classification note when overriding the leave decision.
  decisionNote String?
  decidedById  String?
  decidedBy    User?    @relation("HrLeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

