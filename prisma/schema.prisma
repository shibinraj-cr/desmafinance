generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  email               String?           @unique
  passwordHash        String
  // Legacy string role kept for backward compat — capability checks now
  // prefer the `roleRef` relation when present and fall back to this.
  role                String            @default("executive")
  roleId              String?
  roleRef             Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        Transaction[]
  auditLogs           AuditLog[]
  submittedApprovals  PendingApproval[] @relation("submittedApprovals")
  reviewedApprovals   PendingApproval[] @relation("reviewedApprovals")

  @@index([roleId])
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // Capability flags
  isAdmin       Boolean  @default(false) // Manage users + roles, see everything
  canApprove    Boolean  @default(false) // Approve/reject pending changes
  needsApproval Boolean  @default(true)  // Their tx mutations enter the queue
  // List of page paths this role is allowed to view (e.g. ["/overview", "/revenue"])
  pages         String[]
  // Built-in roles (Admin/Manager/Executive) cannot be deleted
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  month       String
  type        String
  category    String
  subItem     String
  description String?
  paymentMode String
  amount      Decimal   @db.Decimal(14, 2)
  flow        String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pendingApprovals PendingApproval[] @relation("targetTransaction")

  @@index([date])
  @@index([month])
  @@index([type])
  @@index([category])
  @@index([deletedAt])
  @@index([month, type])
  @@index([paymentMode, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model PendingApproval {
  id            String       @id @default(cuid())
  kind          String       // "create" | "update" | "delete"
  status        String       @default("pending") // "pending" | "approved" | "rejected"
  targetTxId    String?
  targetTx      Transaction? @relation("targetTransaction", fields: [targetTxId], references: [id], onDelete: SetNull)
  proposed      Json?        // proposed transaction values (null for delete)
  submittedById String?
  submittedBy   User?        @relation("submittedApprovals", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?        @relation("reviewedApprovals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([targetTxId])
}
