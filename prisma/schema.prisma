generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  email               String?           @unique
  passwordHash        String
  // Legacy string role kept for backward compat — capability checks now
  // prefer the `roleRef` relation when present and fall back to this.
  role                String            @default("executive")
  roleId              String?
  roleRef             Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        Transaction[]
  auditLogs           AuditLog[]
  submittedApprovals  PendingApproval[] @relation("submittedApprovals")
  reviewedApprovals   PendingApproval[] @relation("reviewedApprovals")
  // Lead Pulse relations
  leadPulseRole       LeadPulseRole?
  leadPulseEntries    LeadPulseDailyEntry[] @relation("LeadPulseEntries")
  leadPulseMeta       LeadPulseDailyMeta[]  @relation("LeadPulseMeta")
  leadPulseAuditLogs  LeadPulseAuditLog[]   @relation("LeadPulseAudit")

  @@index([roleId])
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // Capability flags
  isAdmin       Boolean  @default(false) // Manage users + roles, see everything
  canApprove    Boolean  @default(false) // Approve/reject pending changes
  needsApproval Boolean  @default(true)  // Their tx mutations enter the queue
  // List of page paths this role is allowed to view (e.g. ["/overview", "/revenue"])
  pages         String[]
  // Built-in roles (Admin/Manager/Executive) cannot be deleted
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  month       String
  type        String
  category    String
  subItem     String
  description String?
  paymentMode String
  amount      Decimal   @db.Decimal(14, 2)
  flow        String
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pendingApprovals PendingApproval[] @relation("targetTransaction")

  @@index([date])
  @@index([month])
  @@index([type])
  @@index([category])
  @@index([deletedAt])
  @@index([month, type])
  @@index([paymentMode, type])
  @@index([partyId])
}

// Master: transaction Categories. A category can be Revenue-only,
// Expense-only, or available for Both.
model Category {
  id        String        @id @default(cuid())
  name      String
  // 'Revenue' | 'Expense' | 'Both'
  type      String
  isActive  Boolean       @default(true)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  subItems  SubCategory[]

  @@unique([name, type])
  @@index([type])
  @@index([isActive])
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean  @default(true)
  isSystem   Boolean  @default(false)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@index([serviceId])
}

model Service {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  subItems    SubCategory[]

  @@index([isActive])
}

// ──────────────────────────────────────────────────────────────────────
// Lead Pulse — Marketing module sub-feature.
//
// Manual lead-tracking and funnel reporting tool layered on top of
// existing DESFIN auth. Users get a Lead Pulse–specific role
// (l1 / l2 / supervisor) via LeadPulseRole, distinct from DESFIN's
// general Role record on User.
// ──────────────────────────────────────────────────────────────────────

model LeadPulseRole {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'l1' | 'l2' | 'supervisor'
  role         String
  // Region codes from LeadPulseRegion.code; empty array = all regions.
  regionFocus  String[] @default([])
  displayName  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model LeadPulseSource {
  id           String                @id @default(cuid())
  code         String                @unique
  label        String
  displayOrder Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  entries      LeadPulseDailyEntry[]
  snapshots    LeadPulseMonthlySnapshot[]

  @@index([active])
  @@index([displayOrder])
}

model LeadPulseRegion {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model LeadPulseDailyEntry {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(name: "LeadPulseEntries", fields: [userId], references: [id], onDelete: Cascade)
  entryDate DateTime        @db.Date
  sourceId  String
  source    LeadPulseSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // Snapshot of role at submission so historical reports stay accurate
  // even if the user's role changes later.
  roleAtEntry String

  // L1 fields (nullable; only set when roleAtEntry = 'l1')
  leadsReceived    Int?
  connectedCalls   Int?
  disqualified     Int?
  transferredToL2  Int?

  // L2 fields (nullable; only set when roleAtEntry = 'l2')
  receivedFromL1 Int?
  directLeads    Int?
  connected      Int?
  quoteSent      Int?
  closedWon      Int?
  closedLost     Int?

  // Common
  status      String   @default("draft") // 'draft' | 'submitted'
  submittedAt DateTime?
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, entryDate, sourceId])
  @@index([entryDate])
  @@index([userId, entryDate])
  @@index([sourceId])
  @@index([status])
}

model LeadPulseDailyMeta {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(name: "LeadPulseMeta", fields: [userId], references: [id], onDelete: Cascade)
  entryDate        DateTime  @db.Date
  totalFollowups   Int?      // L1 only
  referredToDoc    Int?      // L2 only
  referredToAbroad Int?      // L1 or L2
  notes            String?
  status           String    @default("draft")
  submittedAt      DateTime?
  locked           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, entryDate])
  @@index([entryDate])
}

model LeadPulseAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(name: "LeadPulseAudit", fields: [actorUserId], references: [id], onDelete: SetNull)
  // 'entry_submitted' | 'entry_edited' | 'entry_locked_override' |
  // 'role_assigned' | 'role_changed' | 'source_added' | 'source_disabled' |
  // 'region_added' | 'region_disabled'
  eventType  String
  targetId   String?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
  @@index([actorUserId])
}

model LeadPulseMonthlySnapshot {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  // null = team-level row
  userId        String?
  // 'l1' | 'l2'
  role          String
  // null = total-across-sources row
  sourceId      String?
  source        LeadPulseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  totalLeads    Int      @default(0)
  totalWon      Int      @default(0)
  conversionPct Decimal  @db.Decimal(5, 2) @default(0)
  computedAt    DateTime @default(now())

  @@unique([year, month, userId, role, sourceId])
  @@index([year, month])
}


// Master: parties (candidates / vendors) referenced by transactions.
model Party {
  id        String   @id @default(cuid())
  name      String   @unique
  // 'Candidate' | 'Vendor'
  group     String
  // What transaction types this party may be linked to: 'Revenue' | 'Expense' | 'Both'
  txTypes   String   @default("Both")
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([group])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model PendingApproval {
  id            String       @id @default(cuid())
  kind          String       // "create" | "update" | "delete"
  status        String       @default("pending") // "pending" | "approved" | "rejected"
  targetTxId    String?
  targetTx      Transaction? @relation("targetTransaction", fields: [targetTxId], references: [id], onDelete: SetNull)
  proposed      Json?        // proposed transaction values (null for delete)
  submittedById String?
  submittedBy   User?        @relation("submittedApprovals", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?        @relation("reviewedApprovals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([targetTxId])
}
