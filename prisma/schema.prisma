  publishedBy   User?                     @relation("HrPolicyPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  requiresAck   Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
