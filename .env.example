# Postgres connection string (Vercel Postgres / Neon / Supabase)
# Local dev tip: install Postgres or use https://neon.tech (free) and paste the connection URL here.
DATABASE_URL="postgresql://user:password@host:5432/desma?sslmode=require"

# NextAuth
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used for shareable links (e.g. the psychometric assignment
# link sent to employees). REQUIRED in production so links use the real domain
# instead of localhost. Leave unset locally to fall back to the dev host.
APP_BASE_URL="https://desgro.in"

# Initial admin user (created by `pnpm db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_EMAIL="admin@desma.local"

# Claude / Anthropic — powers the Lead Pulse Growth Planner AI recommendations
# and what-if answers. OPTIONAL: leave unset and the planner falls back to a
# built-in rule-based analysis. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-sonnet-4-6)
PLANNER_AI_MODEL="claude-sonnet-4-6"

# Shared secret for the Meta lead-ads → CRM webhook (POST /api/integrations/meta-leads).
# The Google Apps Script bound to the Meta spreadsheet must send this exact value
# in the `x-webhook-secret` header. Generate one: openssl rand -base64 32
# Leave unset to disable the webhook (it returns 503). See integrations/meta-leads/.
META_LEADS_WEBHOOK_SECRET=""
