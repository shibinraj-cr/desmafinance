generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  email               String?           @unique
  passwordHash        String
  // Legacy string role kept for backward compat — capability checks now
  // prefer the `roleRef` relation when present and fall back to this.
  role                String            @default("executive")
  roleId              String?
  roleRef             Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        Transaction[]
  auditLogs           AuditLog[]
  submittedApprovals  PendingApproval[] @relation("submittedApprovals")
  reviewedApprovals   PendingApproval[] @relation("reviewedApprovals")
  // Lead Pulse relations
  leadPulseRole       LeadPulseRole?
  leadPulseEntries    LeadPulseDailyEntry[] @relation("LeadPulseEntries")
  leadPulseMeta       LeadPulseDailyMeta[]  @relation("LeadPulseMeta")
  leadPulseMetaReviewed LeadPulseDailyMeta[] @relation("LeadPulseMetaReviewed")
  leadPulseAuditLogs  LeadPulseAuditLog[]   @relation("LeadPulseAudit")
  leadPulseTargets        LeadPulseTarget[]   @relation("LeadPulseTargets")
  leadPulseTargetsEdited  LeadPulseTarget[]   @relation("LeadPulseTargetEditors")
  // Candidates assigned to this user as their L2 BDE (the BDE who
  // closed the deal). Drives the service-conversion matrix.
  assignedCandidates  Party[]               @relation("PartyAssignedL2Bde")
  // Marketing holiday calendar edits
  holidaysCreated     Holiday[]             @relation("HolidaysCreated")
  holidaysUpdated     Holiday[]             @relation("HolidaysUpdated")
  // Voxbay CSV uploads
  voxbayUploads       VoxbayUpload[]        @relation("VoxbayUploads")
  // Per-user "draft first" workflow flag — when true, new transactions
  // created by this user are stored as TransactionDraft rows for them
  // to review/edit before pushing into the regular approval queue.
  // Used for Ganga's review-before-submit flow.
  draftFirst          Boolean               @default(false)
  transactionDrafts   TransactionDraft[]
  // L2 BDE pipeline (in-flight expected closes)
  leadPulsePipeline   LeadPulsePipeline[]   @relation("LeadPulsePipeline")
  // Supervisor-granted unlocks for the daily-entry backdate window
  leadPulseUnlocks       LeadPulseUnlock[] @relation("LeadPulseUnlockTarget")
  leadPulseUnlocksGiven  LeadPulseUnlock[] @relation("LeadPulseUnlockActor")
  // Monthly AI-style insight + Q&A loop on the BDE performance page
  leadPulseBdeInsights LeadPulseBdeInsight[] @relation("BdeInsights")
  collectionPlansCreated CollectionPlan[]   @relation("CollectionPlanCreatedBy")

  // HR relations
  employeeProfile        Employee?              @relation("UserEmployee")
  hrAttendanceUploads    HrAttendanceUpload[]   @relation("HrUploader")
  hrLeaveReviews         HrLeaveRequest[]       @relation("HrLeaveReviewer")
  hrSalaryRunsCreated    HrSalaryRun[]          @relation("HrSalaryRunCreator")
  hrSalaryRunsApproved   HrSalaryRun[]          @relation("HrSalaryRunApprover")
  hrPoliciesPublished    HrPolicy[]             @relation("HrPolicyPublisher")
  hrTrainingsCreated     HrTraining[]           @relation("HrTrainingCreator")
  hrNotificationsCreated HrNotification[]       @relation("HrNotificationCreator")
  hrAuditLogs            HrAuditLog[]           @relation("HrAuditActor")
  hrLeaveDecisions       HrAttendanceDay[]      @relation("HrLeaveDecider")

  @@index([roleId])
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // Capability flags
  isAdmin       Boolean  @default(false) // Manage users + roles, see everything
  canApprove    Boolean  @default(false) // Approve/reject pending changes
  needsApproval Boolean  @default(true)  // Their tx mutations enter the queue
  // List of page paths this role is allowed to view (e.g. ["/overview", "/revenue"])
  pages         String[]
  // Built-in roles (Admin/Manager/Executive) cannot be deleted
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  month       String
  type        String
  category    String
  subItem     String
  description String?
  paymentMode String
  amount      Decimal   @db.Decimal(14, 2)
  flow        String
  /// "EXP" (export) | "DOM" (domestic). Only meaningful for Revenue
  /// rows — Expense rows leave it null. Drives the GST liability
  /// calc on the Revenue Analysis page: only DOM revenue carries
  /// the 18% GST line.
  expDom      String?
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pendingApprovals PendingApproval[] @relation("targetTransaction")
  collectionInstallment CollectionPlanInstallment? @relation("InstallmentTransaction")

  @@index([date])
  @@index([month])
  @@index([type])
  @@index([category])
  @@index([deletedAt])
  @@index([month, type])
  @@index([paymentMode, type])
  @@index([partyId])
}

// Master: transaction Categories. A category can be Revenue-only,
// Expense-only, or available for Both.
model Category {
  id        String        @id @default(cuid())
  name      String
  // 'Revenue' | 'Expense' | 'Both'
  type      String
  isActive  Boolean       @default(true)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  subItems  SubCategory[]

  @@unique([name, type])
  @@index([type])
  @@index([isActive])
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean  @default(true)
  isSystem   Boolean  @default(false)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@index([serviceId])
}

model Service {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  isSystem    Boolean       @default(false)
  // Whether this service appears as a column on the L2 Targets matrix.
  showInL2Targets Boolean   @default(true)
  // Weight of this service when computing a group's actual on the
  // L2 Targets matrix. e.g. weight = 2 means a party closed against
  // this service counts as 2 toward the BDE's group total. Default
  // 1 means every service counts equally.
  weight      Float         @default(1)
  // Optional grouping for the L2 Targets matrix. Services in the same
  // group share a single per-month target; the matrix columns are
  // groups, not individual services.
  groupId     String?
  group       ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  subItems    SubCategory[]
  // Legacy M:M (read-only at this point) — new code uses partyServices.
  parties     Party[]
  partyServices PartyService[]
  leadPulseTargets LeadPulseTarget[]
  leadPulseCloses LeadPulseDailyClose[]
  leadPulsePipeline LeadPulsePipeline[]
  collectionPlans CollectionPlan[]

  @@index([isActive])
  @@index([groupId])
}

/// Groups that bundle multiple Services together so the L2 Targets
/// matrix can be driven at the group level (e.g. "Australia", "New
/// Zealand", "Study Abroad"). Each Service belongs to at most one
/// group.
model ServiceGroup {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  services     Service[]
  leadPulseTargets LeadPulseTarget[]

  @@index([isActive])
  @@index([displayOrder])
}

/// Explicit join between Party and Service that carries the candidate-
/// specific quoted total for that service. Replaces the legacy Party↔Service
/// M:M for any flow that needs an amount or per-service notes.
model PartyService {
  id          String   @id @default(cuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  /// Quoted package amount (₹) the candidate owes for this service.
  totalAmount Decimal  @db.Decimal(14, 2) @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([partyId, serviceId])
  @@index([partyId])
  @@index([serviceId])
}

// ──────────────────────────────────────────────────────────────────────
// Lead Pulse — Marketing module sub-feature.
//
// Manual lead-tracking and funnel reporting tool layered on top of
// existing DESFIN auth. Users get a Lead Pulse–specific role
// (l1 / l2 / supervisor) via LeadPulseRole, distinct from DESFIN's
// general Role record on User.
// ──────────────────────────────────────────────────────────────────────

model LeadPulseRole {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'l1' | 'l2' | 'supervisor'
  role         String
  // Region codes from LeadPulseRegion.code; empty array = all regions.
  regionFocus  String[] @default([])
  displayName  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model LeadPulseSource {
  id           String                @id @default(cuid())
  code         String                @unique
  label        String
  displayOrder Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  entries      LeadPulseDailyEntry[]
  snapshots    LeadPulseMonthlySnapshot[]
  parties      Party[]
  leadPulsePipeline LeadPulsePipeline[]

  @@index([active])
  @@index([displayOrder])
}

model LeadPulseRegion {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model LeadPulseDailyEntry {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(name: "LeadPulseEntries", fields: [userId], references: [id], onDelete: Cascade)
  entryDate DateTime        @db.Date
  sourceId  String
  source    LeadPulseSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // Snapshot of role at submission so historical reports stay accurate
  // even if the user's role changes later.
  roleAtEntry String

  // L1 fields (nullable; only set when roleAtEntry = 'l1')
  leadsReceived    Int?
  connectedCalls   Int?
  disqualified     Int?
  transferredToL2  Int?

  // L2 fields (nullable; only set when roleAtEntry = 'l2')
  receivedFromL1 Int?
  directLeads    Int?
  connected      Int?
  quoteSent      Int?
  closedWon      Int?
  closedLost     Int?

  // Common
  status      String   @default("draft") // 'draft' | 'submitted'
  submittedAt DateTime?
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Per-close service tag — only populated for L2 rows with
  // closedWon > 0. One row per closed lead so the same service can
  // appear multiple times for a single (BDE, source, date).
  closes LeadPulseDailyClose[]

  @@unique([userId, entryDate, sourceId])
  @@index([entryDate])
  @@index([userId, entryDate])
  @@index([sourceId])
  @@index([status])
}

/// One row per closed-won lead an L2 BDE logged on a given (user,
/// date, source). Captures which Service the BDE intended to credit
/// the close to. Same service can appear N times for N closes.
model LeadPulseDailyClose {
  id        String              @id @default(cuid())
  entryId   String
  entry     LeadPulseDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt DateTime            @default(now())
  // Back-reference: the pipeline row whose closed_won flip created
  // this close (if any). Lets the status route find + remove the
  // close cleanly when a row is re-opened.
  pipeline  LeadPulsePipeline?  @relation("PipelineDailyClose")

  @@index([entryId])
  @@index([serviceId])
}

/// L2 BDE in-flight deal pipeline. One row per (BDE, candidate,
/// service) — a deal expected to close on `expectedCloseDate` with
/// `expectedFirstInstallment` ₹. Flipping `status` to closed_won
/// also inserts a LeadPulseDailyClose into the BDE's daily entry
/// for `closedDate`, so the existing Targets matrix picks it up.
model LeadPulsePipeline {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation("LeadPulsePipeline", fields: [userId], references: [id], onDelete: Cascade)

  candidateName            String
  /// Free-text phone number captured at pipeline entry — kept as a
  /// string so country codes / hyphens / WhatsApp prefixes survive
  /// round-trips. No format validation; supervisor checks the value.
  candidatePhone           String?
  partyId                  String?
  party                    Party?   @relation("PartyPipeline", fields: [partyId], references: [id], onDelete: SetNull)

  serviceId                String
  service                  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sourceId                 String
  source                   LeadPulseSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  expectedCloseDate        DateTime @db.Date
  expectedFirstInstallment Decimal  @db.Decimal(14, 2) @default(0)

  // 'open' | 'closed_won' | 'lost'
  status                   String   @default("open")
  closedDate               DateTime? @db.Date
  // If a closed_won flip created a LeadPulseDailyClose, link to it
  // so re-opening can delete it cleanly.
  dailyCloseId             String?  @unique
  dailyClose               LeadPulseDailyClose? @relation("PipelineDailyClose", fields: [dailyCloseId], references: [id], onDelete: SetNull)
  notes                    String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId, expectedCloseDate, status])
  @@index([partyId])
  @@index([serviceId])
  @@index([sourceId])
  @@index([status, expectedCloseDate])
}

model LeadPulseDailyMeta {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(name: "LeadPulseMeta", fields: [userId], references: [id], onDelete: Cascade)
  entryDate        DateTime  @db.Date
  totalFollowups   Int?      // L1 only
  referredToDoc    Int?      // L2 only
  referredToAbroad Int?      // L1 or L2
  notes            String?
  // status: 'draft' (in progress) | 'submitted' (awaiting supervisor) |
  //         'approved' (signed off) | 'rejected' (sent back to BDE)
  status           String    @default("draft")
  submittedAt      DateTime?
  locked           Boolean   @default(false)
  // Supervisor review trail for the approval workflow.
  reviewedById     String?
  reviewedBy       User?     @relation(name: "LeadPulseMetaReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, entryDate])
  @@index([entryDate])
  @@index([status])
  @@index([reviewedById])
}

/// One row per (BDE, date) when a supervisor grants edit access to an
/// entry that would otherwise be blocked by the 3-day backdate window.
/// Lets the BDE save edits for older days; cleared automatically when
/// the BDE re-submits a row for that date. Independent from the
/// per-entry `locked` flag, which gates edits to *already-submitted*
/// entries — both gates need to pass.
model LeadPulseUnlock {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(name: "LeadPulseUnlockTarget", fields: [userId], references: [id], onDelete: Cascade)
  entryDate    DateTime @db.Date
  unlockedAt   DateTime @default(now())
  unlockedById String?
  unlockedBy   User?    @relation(name: "LeadPulseUnlockActor", fields: [unlockedById], references: [id], onDelete: SetNull)

  @@unique([userId, entryDate])
  @@index([userId])
  @@index([entryDate])
}

model LeadPulseAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(name: "LeadPulseAudit", fields: [actorUserId], references: [id], onDelete: SetNull)
  // 'entry_submitted' | 'entry_edited' | 'entry_locked_override' |
  // 'role_assigned' | 'role_changed' | 'source_added' | 'source_disabled' |
  // 'region_added' | 'region_disabled'
  eventType  String
  targetId   String?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
  @@index([actorUserId])
}

model LeadPulseMonthlySnapshot {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  // null = team-level row
  userId        String?
  // 'l1' | 'l2'
  role          String
  // null = total-across-sources row
  sourceId      String?
  source        LeadPulseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  totalLeads    Int      @default(0)
  totalWon      Int      @default(0)
  conversionPct Decimal  @db.Decimal(5, 2) @default(0)
  computedAt    DateTime @default(now())

  @@unique([year, month, userId, role, sourceId])
  @@index([year, month])
}

/// Per-month per-L2-BDE per-Service target. Suhaina (or any supervisor)
/// edits these via /marketing/lead-pulse/targets; actuals are derived
/// from Party.assignedL2BdeId × PartyService × Revenue Transaction.
model LeadPulseTarget {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  userId      String
  user        User     @relation(name: "LeadPulseTargets", fields: [userId], references: [id], onDelete: Cascade)
  // A target is either against an individual Service (legacy rows) or
  // a ServiceGroup (current model). Exactly one of these is set per
  // row — enforced at the API layer rather than as a DB check
  // constraint so the migration can keep historical per-service rows.
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  groupId     String?
  group       ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  target      Int      @default(0)
  updatedById String?
  updatedBy   User?    @relation(name: "LeadPulseTargetEditors", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month, userId, serviceId])
  @@unique([year, month, userId, groupId])
  @@index([year, month])
  @@index([userId])
  @@index([groupId])
}

// Marketing holiday calendar. Sundays are implicit and never stored.
// One row per date, supervisor-editable.
/// Shared holiday calendar — used by both the Marketing holiday-calendar
/// page (skips entries when computing working days for Lead Pulse) and
/// the HR side (treated as paid holiday in attendance + salary). Both
/// modules read and write this table, gated by their own role checks.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  label       String
  notes       String?
  /// Whether the holiday is paid (default true). Currently every entry
  /// is paid; the flag exists for future "unpaid optional holiday" use.
  paid        Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(name: "HolidaysCreated", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation(name: "HolidaysUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}


// Master: parties (candidates / vendors) referenced by transactions.
model Party {
  id        String   @id @default(cuid())
  name      String   @unique
  // 'Candidate' | 'Vendor'
  group     String
  // What transaction types this party may be linked to: 'Revenue' | 'Expense' | 'Both'
  txTypes   String   @default("Both")
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  // Source (lead origin) — only meaningful for Candidates. Pulls from
  // LeadPulseSource so the dropdown stays in sync with the marketing
  // module's source list.
  sourceId  String?
  source    LeadPulseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // L2 BDE who closed this candidate. Populated by Suhaina (or any
  // supervisor) on the candidate detail page; drives the service-
  // conversion matrix on /marketing/lead-pulse/targets.
  assignedL2BdeId String?
  assignedL2Bde   User?   @relation(name: "PartyAssignedL2Bde", fields: [assignedL2BdeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  transactionDrafts TransactionDraft[]
  // Legacy implicit M:M kept for backwards compatibility — new UI uses
  // partyServices (with totalAmount). Will be removed once
  // migrate-party-services has been run everywhere.
  services      Service[]
  partyServices PartyService[]
  pipelineRows  LeadPulsePipeline[] @relation("PartyPipeline")
  collectionPlans CollectionPlan[]

  @@index([group])
  @@index([isActive])
  @@index([sourceId])
  @@index([assignedL2BdeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model PendingApproval {
  id            String       @id @default(cuid())
  kind          String       // "create" | "update" | "delete"
  status        String       @default("pending") // "pending" | "approved" | "rejected"
  targetTxId    String?
  targetTx      Transaction? @relation("targetTransaction", fields: [targetTxId], references: [id], onDelete: SetNull)
  proposed      Json?        // proposed transaction values (null for delete)
  submittedById String?
  submittedBy   User?        @relation("submittedApprovals", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?        @relation("reviewedApprovals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Back-link: when an installment is submitted to the approval queue
  /// the resulting PendingApproval row carries this FK so approve/reject
  /// can flip the installment status without scanning the queue.
  collectionInstallmentId String? @unique
  collectionInstallment   CollectionPlanInstallment? @relation("InstallmentPending", fields: [collectionInstallmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([targetTxId])
}

/// Personal "draft" transactions for users with User.draftFirst=true.
/// They never enter the approval queue until the user explicitly
/// submits them from the My Drafts page — at which point a normal
/// PendingApproval row is created and the draft is deleted.
model TransactionDraft {
  id            String   @id @default(cuid())
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  // Same fields as the canonical Transaction shape so the My Drafts
  // table can render and edit them in place.
  date          DateTime
  month         String
  type          String
  category      String
  subItem       String
  description   String?
  paymentMode   String
  amount        Decimal  @db.Decimal(14, 2)
  flow          String
  partyId       String?
  party         Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// Mirrors Transaction.expDom — required on Revenue drafts.
  expDom        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([submittedById])
  @@index([createdAt])
}

/// Metadata about each Voxbay CSV upload. The actual call rows live
/// in VoxbayCall. New rows in an upload are merged in; existing rows
/// that don't appear in the new CSV are preserved (a partial export
/// won't wipe historical data).
model VoxbayUpload {
  id            String   @id @default(cuid())
  uploadedById  String?
  uploadedBy    User?    @relation(name: "VoxbayUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  filename      String?
  rowCount      Int      @default(0)
  uploadedAt    DateTime @default(now())

  @@index([uploadedAt])
}

/// One parsed row from the Voxbay incoming-call report. Durations
/// are normalised to seconds for analytics; the original HH:MM:SS
/// string is preserved on `*Display` for the table.
model VoxbayCall {
  id                  String    @id @default(cuid())
  /// Deterministic identity key for merge-on-upload semantics:
  /// `${sourceNumber}|${didNumber}|${callStartTime.toISOString()}`.
  /// Nullable for legacy rows; populated by the upload route + a
  /// backfill DDL step.
  signature           String?   @unique
  slNo                Int?
  contactName         String?
  sourceNumber        String?
  didNumber           String?
  cost                Float?
  dtmfSeq             String?
  callStartTime       DateTime?
  callConnectedTime   DateTime?
  callStatus          String?
  userStatus          String?
  stickyStatus        String?
  holdTime            String?
  callRecordFile      String?
  application         String?
  extNumber           String?
  appName             String?
  agentName           String?
  lastTriedName       String?
  firstTriedName      String?
  totalDurationSec    Int       @default(0)
  totalDurationDisplay String?
  answeredDurationSec Int       @default(0)
  answeredDurationDisplay String?
  deptName            String?
  disposition         String?
  latestComment       String?
  createdAt           DateTime  @default(now())

  @@index([callStartTime])
  @@index([callStatus])
  @@index([userStatus])
  @@index([agentName])
  @@index([lastTriedName])
}

/// One per (BDE, year, month) row holding the AI-style coaching loop
/// shown on the BDE performance page. The system writes the initial
/// analysis + 3 questions; the BDE writes their answers; the system
/// writes follow-up feedback. Admins can read everyone's; BDEs only
/// see their own.
model LeadPulseBdeInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(name: "BdeInsights", fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int

  /// Initial markdown analysis the BDE reads before answering.
  analysis    String
  /// JSON: Array<{ id: string; question: string; hint?: string }>.
  questions   Json
  /// JSON: Record<string, string>  (question id → BDE's answer).
  answers     Json?
  /// Follow-up markdown feedback written after answers are submitted.
  feedback    String?

  /// 'draft' before BDE answers, 'answered' once submitted.
  status      String   @default("draft")
  answeredAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
}

/// A collection plan: N expected installments (CollectionPlanInstallment)
/// against a candidate (Party). Created by a Finance Executive on the
/// /finance/collection-plan page so receivables can be staged ahead of
/// time. Each installment can be submitted to the Daily Tracker for
/// approval, at which point a normal Transaction (or PendingApproval)
/// is created and linked back to the installment via the installment's
/// pendingApprovalId / transactionId fields.
model CollectionPlan {
  id          String   @id @default(cuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Optional service this plan corresponds to (e.g. AHPRA, PR).
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  label       String
  /// Default category / sub-item / payment-mode the installments inherit
  /// when none is explicitly set on the installment row. Captured at
  /// submit-to-Daily-Tracker time rather than plan-create time, so all
  /// four are nullable until an installment is actually pushed through.
  category    String?
  subItem     String?
  paymentMode String?
  /// EXP / DOM tag for Revenue rows. Picked at submit time too.
  expDom      String?
  notes       String?
  status      String   @default("active") // 'active' | 'closed' | 'cancelled'
  createdById String?
  createdBy   User?    @relation("CollectionPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments CollectionPlanInstallment[]

  @@index([partyId])
  @@index([serviceId])
  @@index([status])
  @@index([createdById])
}

/// One expected installment line on a CollectionPlan.
model CollectionPlanInstallment {
  id          String   @id @default(cuid())
  planId      String
  plan        CollectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 1-based ordering inside the plan. Unique per plan.
  seq         Int
  expectedDate DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  /// Optional per-installment overrides; fall back to plan defaults when null.
  category    String?
  subItem     String?
  paymentMode String?
  description String?
  /// 'pending'    — staged, not yet pushed to daily tracker.
  /// 'submitted'  — waiting on supervisor in the approval queue.
  /// 'received'   — approved + transaction row exists.
  /// 'cancelled'  — installment scrapped (no transaction).
  status      String   @default("pending")
  /// FK back to the active PendingApproval row (if status='submitted').
  pendingApprovalId String? @unique
  pending     PendingApproval? @relation("InstallmentPending")
  /// FK to the canonical Transaction (if status='received').
  transactionId String? @unique
  transaction   Transaction? @relation("InstallmentTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planId, seq])
  @@index([planId])
  @@index([status])
  @@index([expectedDate])
}

