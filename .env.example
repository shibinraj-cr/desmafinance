# Postgres connection string (Vercel Postgres / Neon / Supabase)
# Local dev tip: install Postgres or use https://neon.tech (free) and paste the connection URL here.
DATABASE_URL="postgresql://user:password@host:5432/desma?sslmode=require"

# NextAuth
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Initial admin user (created by `pnpm db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_EMAIL="admin@desma.local"
