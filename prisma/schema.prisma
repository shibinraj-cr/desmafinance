generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(cuid())
  username               String                @unique
  email                  String?               @unique
  passwordHash           String
  // Soft-disable. An inactive user keeps ALL their data but cannot sign in and
  // loses access on their next request. Toggled from User Management; preferred
  // over deleting a user (delete cascades their Lead Pulse history).
  isActive               Boolean               @default(true)
  // Legacy string role kept for backward compat — capability checks now
  // prefer the `roleRef` relation when present and fall back to this.
  role                   String                @default("executive")
  roleId                 String?
  roleRef                Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  transactions           Transaction[]
  auditLogs              AuditLog[]
  submittedApprovals     PendingApproval[]     @relation("submittedApprovals")
  reviewedApprovals      PendingApproval[]     @relation("reviewedApprovals")
  // Lead Pulse relations
  leadPulseRole          LeadPulseRole?
  leadPulseEntries       LeadPulseDailyEntry[] @relation("LeadPulseEntries")
  leadPulseMeta          LeadPulseDailyMeta[]  @relation("LeadPulseMeta")
  leadPulseMetaReviewed  LeadPulseDailyMeta[]  @relation("LeadPulseMetaReviewed")
  leadPulseAuditLogs     LeadPulseAuditLog[]   @relation("LeadPulseAudit")
  leadPulseTargets       LeadPulseTarget[]     @relation("LeadPulseTargets")
  leadPulseTargetsEdited LeadPulseTarget[]     @relation("LeadPulseTargetEditors")
  // Candidates assigned to this user as their L2 BDE (the BDE who
  // closed the deal). Drives the service-conversion matrix.
  assignedCandidates     Party[]               @relation("PartyAssignedL2Bde")
  // Marketing holiday calendar edits
  holidaysCreated        Holiday[]             @relation("HolidaysCreated")
  holidaysUpdated        Holiday[]             @relation("HolidaysUpdated")
  // Voxbay CSV uploads
  voxbayUploads          VoxbayUpload[]        @relation("VoxbayUploads")
  // Per-user "draft first" workflow flag — when true, new transactions
  // created by this user are stored as TransactionDraft rows for them
  // to review/edit before pushing into the regular approval queue.
  // Used for Ganga's review-before-submit flow.
  draftFirst             Boolean               @default(false)
  transactionDrafts      TransactionDraft[]
  // L2 BDE pipeline (in-flight expected closes)
  leadPulsePipeline      LeadPulsePipeline[]   @relation("LeadPulsePipeline")
  // Supervisor-granted unlocks for the daily-entry backdate window
  leadPulseUnlocks       LeadPulseUnlock[]     @relation("LeadPulseUnlockTarget")
  leadPulseUnlocksGiven  LeadPulseUnlock[]     @relation("LeadPulseUnlockActor")
  // Monthly AI-style insight + Q&A loop on the BDE performance page
  leadPulseBdeInsights   LeadPulseBdeInsight[] @relation("BdeInsights")
  collectionPlansCreated CollectionPlan[]      @relation("CollectionPlanCreatedBy")
  // Manual monthly Meta ad-spend entries edited in the Growth Planner
  leadPulseMetaSpendEdits LeadPulseMetaSpend[] @relation("LeadPulseMetaSpendEditor")

  // HR relations
  employeeProfile        Employee?            @relation("UserEmployee")
  hrAttendanceUploads    HrAttendanceUpload[] @relation("HrUploader")
  hrLeaveReviews         HrLeaveRequest[]     @relation("HrLeaveReviewer")
  hrSalaryRunsCreated    HrSalaryRun[]        @relation("HrSalaryRunCreator")
  hrSalaryRunsApproved   HrSalaryRun[]        @relation("HrSalaryRunApprover")
  hrSalaryAdjustments    HrSalaryAdjustment[] @relation("HrSalaryAdjustmentCreator")
  hrPoliciesPublished    HrPolicy[]           @relation("HrPolicyPublisher")
  hrTrainingsCreated     HrTraining[]         @relation("HrTrainingCreator")
  hrNotificationsCreated HrNotification[]     @relation("HrNotificationCreator")
  hrAuditLogs            HrAuditLog[]         @relation("HrAuditActor")
  hrLeaveDecisions       HrAttendanceDay[]    @relation("HrLeaveDecider")
  psychTestsCreated      PsychTest[]          @relation("PsychTestCreator")
  psychAssignmentsGiven  PsychAssignment[]    @relation("PsychAssigner")

  // CRM relations
  assignedLeads          Lead[]               @relation("LeadAssignee")
  createdLeads           Lead[]               @relation("LeadCreatedBy")
  leadNotes              LeadNote[]           @relation("LeadNoteAuthor")
  leadActivities         LeadActivity[]       @relation("LeadActivityActor")
  leadImports            LeadImportBatch[]    @relation("LeadImportUploader")
  crmTasksAssigned       CrmTask[]            @relation("CrmTaskAssignee")
  crmTasksCreated        CrmTask[]            @relation("CrmTaskCreatedBy")
  crmTasksCompleted      CrmTask[]            @relation("CrmTaskCompletedBy")
  crmMessageTemplates    CrmMessageTemplate[] @relation("CrmMessageTemplateCreatedBy")
  appSettings            AppSetting[]         @relation("AppSettingEditor")

  // Operations relations
  opsTemplatesCreated    ProcessTemplate[]    @relation("OpsTemplateCreatedBy")
  opsProjectsAssigned    OpsProject[]         @relation("OpsProjectAssignee")
  opsProjectsCreated     OpsProject[]         @relation("OpsProjectCreatedBy")
  opsTasksAssigned       OpsTask[]            @relation("OpsTaskAssignee")
  opsTasksCompleted      OpsTask[]            @relation("OpsTaskCompletedBy")
  opsDocumentsUploaded   OpsDocument[]        @relation("OpsDocUploadedBy")
  opsActivities          OpsTaskActivity[]    @relation("OpsActivityActor")
  opsActionItemsAssigned  OpsActionItem[]     @relation("OpsActionAssignee")
  opsActionItemsCreated   OpsActionItem[]     @relation("OpsActionCreatedBy")
  opsActionItemsCompleted OpsActionItem[]     @relation("OpsActionCompletedBy")

  // Engagement telemetry (active time per module/page/day)
  moduleUsage ModuleUsageDaily[] @relation("UserModuleUsage")

  @@index([roleId])
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // Capability flags
  isAdmin       Boolean  @default(false) // Manage users + roles, see everything
  canApprove    Boolean  @default(false) // Approve/reject pending changes
  needsApproval Boolean  @default(true) // Their tx mutations enter the queue
  // List of page paths this role is allowed to view (e.g. ["/overview", "/revenue"])
  pages         String[]
  // Built-in roles (Admin/Manager/Executive) cannot be deleted
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  month       String
  type        String
  category    String
  subItem     String
  description String?
  paymentMode String
  amount      Decimal   @db.Decimal(14, 2)
  flow        String
  /// "EXP" (export) | "DOM" (domestic). Only meaningful for Revenue
  /// rows — Expense rows leave it null. Drives the GST liability
  /// calc on the Revenue Analysis page: only DOM revenue carries
  /// the 18% GST line.
  expDom      String?
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// Employee counterparty — used for salary / incentive outflows. A
  /// transaction carries EITHER partyId OR employeeId (enforced at the
  /// app layer, not the DB, so legacy party-less rows stay valid).
  employeeId  String?
  employee    Employee? @relation("EmployeeTransactions", fields: [employeeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pendingApprovals      PendingApproval[]          @relation("targetTransaction")
  collectionInstallment CollectionPlanInstallment? @relation("InstallmentTransaction")

  @@index([date])
  @@index([month])
  @@index([type])
  @@index([category])
  @@index([deletedAt])
  @@index([month, type])
  @@index([paymentMode, type])
  @@index([partyId])
  @@index([employeeId])
}

// Master: transaction Categories. A category can be Revenue-only,
// Expense-only, or available for Both.
model Category {
  id        String        @id @default(cuid())
  name      String
  // 'Revenue' | 'Expense' | 'Both'
  type      String
  isActive  Boolean       @default(true)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  subItems  SubCategory[]

  @@unique([name, type])
  @@index([type])
  @@index([isActive])
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean  @default(true)
  isSystem   Boolean  @default(false)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@index([serviceId])
}

model Service {
  id                String                @id @default(cuid())
  name              String                @unique
  description       String?
  isActive          Boolean               @default(true)
  isSystem          Boolean               @default(false)
  // Whether this service appears as a column on the L2 Targets matrix.
  showInL2Targets   Boolean               @default(true)
  // Weight of this service when computing a group's actual on the
  // L2 Targets matrix. e.g. weight = 2 means a party closed against
  // this service counts as 2 toward the BDE's group total. Default
  // 1 means every service counts equally.
  weight            Float                 @default(1)
  // Optional grouping for the L2 Targets matrix. Services in the same
  // group share a single per-month target; the matrix columns are
  // groups, not individual services.
  groupId           String?
  group             ServiceGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  subItems          SubCategory[]
  // Legacy M:M (read-only at this point) — new code uses partyServices.
  parties           Party[]
  partyServices     PartyService[]
  leadPulseTargets  LeadPulseTarget[]
  leadPulseCloses   LeadPulseDailyClose[]
  leadPulsePipeline LeadPulsePipeline[]
  collectionPlans   CollectionPlan[]
  leads             Lead[]
  processTemplates  ProcessTemplate[]
  opsProjects       OpsProject[]

  @@index([isActive])
  @@index([groupId])
}

/// Groups that bundle multiple Services together so the L2 Targets
/// matrix can be driven at the group level (e.g. "Australia", "New
/// Zealand", "Study Abroad"). Each Service belongs to at most one
/// group.
model ServiceGroup {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  displayOrder     Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  services         Service[]
  leadPulseTargets LeadPulseTarget[]

  @@index([isActive])
  @@index([displayOrder])
}

/// Explicit join between Party and Service that carries the candidate-
/// specific quoted total for that service. Replaces the legacy Party↔Service
/// M:M for any flow that needs an amount or per-service notes.
model PartyService {
  id          String   @id @default(cuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  /// Quoted package amount (₹) the candidate owes for this service.
  totalAmount Decimal  @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  opsProject  OpsProject?

  @@unique([partyId, serviceId])
  @@index([partyId])
  @@index([serviceId])
}

// ──────────────────────────────────────────────────────────────────────
// Lead Pulse — Marketing module sub-feature.
//
// Manual lead-tracking and funnel reporting tool layered on top of
// existing DESFIN auth. Users get a Lead Pulse–specific role
// (l1 / l2 / supervisor) via LeadPulseRole, distinct from DESFIN's
// general Role record on User.
// ──────────────────────────────────────────────────────────────────────

model LeadPulseRole {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'l1' | 'l2' | 'supervisor'
  role        String
  // Region codes from LeadPulseRegion.code; empty array = all regions.
  regionFocus String[] @default([])
  displayName String
  // Consultant contact number, surfaced as the {consultant_phone} merge field in
  // CRM email/WhatsApp templates. Optional — blank renders as an empty string.
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model LeadPulseSource {
  id                String                     @id @default(cuid())
  code              String                     @unique
  label             String
  displayOrder      Int                        @default(0)
  active            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  entries           LeadPulseDailyEntry[]
  snapshots         LeadPulseMonthlySnapshot[]
  parties           Party[]
  leadPulsePipeline LeadPulsePipeline[]
  leads             Lead[]                     @relation("LeadSource")
  // Leads whose ORIGINAL acquisition source was this, but whose primary source
  // was later re-stamped "Existing Candidate" on a re-enrollment (see Lead.originalSource).
  originalSourceLeads Lead[]                   @relation("LeadOriginalSource")

  @@index([active])
  @@index([displayOrder])
}

model LeadPulseRegion {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model LeadPulseDailyEntry {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(name: "LeadPulseEntries", fields: [userId], references: [id], onDelete: Cascade)
  entryDate   DateTime        @db.Date
  sourceId    String
  source      LeadPulseSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // Snapshot of role at submission so historical reports stay accurate
  // even if the user's role changes later.
  roleAtEntry String

  // L1 fields (nullable; only set when roleAtEntry = 'l1')
  leadsReceived   Int?
  connectedCalls  Int?
  disqualified    Int?
  transferredToL2 Int?

  // L2 fields (nullable; only set when roleAtEntry = 'l2')
  receivedFromL1 Int?
  directLeads    Int?
  connected      Int?
  quoteSent      Int?
  closedWon      Int?
  closedLost     Int?

  // Common
  status      String    @default("draft") // 'draft' | 'submitted'
  submittedAt DateTime?
  locked      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Per-close service tag — only populated for L2 rows with
  // closedWon > 0. One row per closed lead so the same service can
  // appear multiple times for a single (BDE, source, date).
  closes LeadPulseDailyClose[]

  @@unique([userId, entryDate, sourceId])
  @@index([entryDate])
  @@index([userId, entryDate])
  @@index([sourceId])
  @@index([status])
}

/// One row per closed-won lead an L2 BDE logged on a given (user,
/// date, source). Captures which Service the BDE intended to credit
/// the close to. Same service can appear N times for N closes.
model LeadPulseDailyClose {
  id        String              @id @default(cuid())
  entryId   String
  entry     LeadPulseDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt DateTime            @default(now())
  // Back-reference: the pipeline row whose closed_won flip created
  // this close (if any). Lets the status route find + remove the
  // close cleanly when a row is re-opened.
  pipeline  LeadPulsePipeline?  @relation("PipelineDailyClose")

  @@index([entryId])
  @@index([serviceId])
}

/// L2 BDE in-flight deal pipeline. One row per (BDE, candidate,
/// service) — a deal expected to close on `expectedCloseDate` with
/// `expectedFirstInstallment` ₹. Flipping `status` to closed_won
/// also inserts a LeadPulseDailyClose into the BDE's daily entry
/// for `closedDate`, so the existing Targets matrix picks it up.
model LeadPulsePipeline {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeadPulsePipeline", fields: [userId], references: [id], onDelete: Cascade)

  candidateName  String
  /// Free-text phone number captured at pipeline entry — kept as a
  /// string so country codes / hyphens / WhatsApp prefixes survive
  /// round-trips. No format validation; supervisor checks the value.
  candidatePhone String?
  partyId        String?
  party          Party?  @relation("PartyPipeline", fields: [partyId], references: [id], onDelete: SetNull)
  // Back-relation for a CRM lead that owns this pipeline entry (1:1).
  leadLink       Lead?   @relation("LeadPipeline")

  serviceId String
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sourceId  String
  source    LeadPulseSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  expectedCloseDate        DateTime @db.Date
  expectedFirstInstallment Decimal  @default(0) @db.Decimal(14, 2)

  // 'open' | 'closed_won' | 'lost'
  status       String               @default("open")
  closedDate   DateTime?            @db.Date
  // If a closed_won flip created a LeadPulseDailyClose, link to it
  // so re-opening can delete it cleanly.
  dailyCloseId String?              @unique
  dailyClose   LeadPulseDailyClose? @relation("PipelineDailyClose", fields: [dailyCloseId], references: [id], onDelete: SetNull)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expectedCloseDate, status])
  @@index([partyId])
  @@index([serviceId])
  @@index([sourceId])
  @@index([status, expectedCloseDate])
}

model LeadPulseDailyMeta {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(name: "LeadPulseMeta", fields: [userId], references: [id], onDelete: Cascade)
  entryDate        DateTime  @db.Date
  totalFollowups   Int? // L1 only
  referredToDoc    Int? // L2 only
  referredToAbroad Int? // L1 or L2
  notes            String?
  // status: 'draft' (in progress) | 'submitted' (awaiting supervisor) |
  //         'approved' (signed off) | 'rejected' (sent back to BDE)
  status           String    @default("draft")
  submittedAt      DateTime?
  locked           Boolean   @default(false)
  // Supervisor review trail for the approval workflow.
  reviewedById     String?
  reviewedBy       User?     @relation(name: "LeadPulseMetaReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, entryDate])
  @@index([entryDate])
  @@index([status])
  @@index([reviewedById])
}

/// One row per (BDE, date) when a supervisor grants edit access to an
/// entry that would otherwise be blocked by the 3-day backdate window.
/// Lets the BDE save edits for older days; cleared automatically when
/// the BDE re-submits a row for that date. Independent from the
/// per-entry `locked` flag, which gates edits to *already-submitted*
/// entries — both gates need to pass.
model LeadPulseUnlock {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(name: "LeadPulseUnlockTarget", fields: [userId], references: [id], onDelete: Cascade)
  entryDate    DateTime @db.Date
  unlockedAt   DateTime @default(now())
  unlockedById String?
  unlockedBy   User?    @relation(name: "LeadPulseUnlockActor", fields: [unlockedById], references: [id], onDelete: SetNull)

  @@unique([userId, entryDate])
  @@index([userId])
  @@index([entryDate])
}

model LeadPulseAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(name: "LeadPulseAudit", fields: [actorUserId], references: [id], onDelete: SetNull)
  // 'entry_submitted' | 'entry_edited' | 'entry_locked_override' |
  // 'role_assigned' | 'role_changed' | 'source_added' | 'source_disabled' |
  // 'region_added' | 'region_disabled'
  eventType   String
  targetId    String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
  @@index([actorUserId])
}

model LeadPulseMonthlySnapshot {
  id            String           @id @default(cuid())
  year          Int
  month         Int
  // null = team-level row
  userId        String?
  // 'l1' | 'l2'
  role          String
  // null = total-across-sources row
  sourceId      String?
  source        LeadPulseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  totalLeads    Int              @default(0)
  totalWon      Int              @default(0)
  conversionPct Decimal          @default(0) @db.Decimal(5, 2)
  computedAt    DateTime         @default(now())

  @@unique([year, month, userId, role, sourceId])
  @@index([year, month])
}

/// Per-month per-L2-BDE per-Service target. Suhaina (or any supervisor)
/// edits these via /marketing/lead-pulse/targets; actuals are derived
/// from Party.assignedL2BdeId × PartyService × Revenue Transaction.
model LeadPulseTarget {
  id          String        @id @default(cuid())
  year        Int
  month       Int
  userId      String
  user        User          @relation(name: "LeadPulseTargets", fields: [userId], references: [id], onDelete: Cascade)
  // A target is either against an individual Service (legacy rows) or
  // a ServiceGroup (current model). Exactly one of these is set per
  // row — enforced at the API layer rather than as a DB check
  // constraint so the migration can keep historical per-service rows.
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  groupId     String?
  group       ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  target      Int           @default(0)
  updatedById String?
  updatedBy   User?         @relation(name: "LeadPulseTargetEditors", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([year, month, userId, serviceId])
  @@unique([year, month, userId, groupId])
  @@index([year, month])
  @@index([userId])
  @@index([groupId])
}

/// Manual monthly Meta ad-spend, entered by supervisors in the Growth Planner.
/// When a row exists for a (year, month) it OVERRIDES the Finance-derived figure
/// (getMetaAdSpend) used by getPlannerBaseline; months without a row fall back to
/// Finance. Drives the blended cost-per-qualified-lead = spend ÷ L2 leads.
model LeadPulseMetaSpend {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  /// Meta ad spend for this month, ₹ whole rupees.
  amount      Int
  note        String?
  updatedById String?
  updatedBy   User?    @relation("LeadPulseMetaSpendEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// Marketing holiday calendar. Sundays are implicit and never stored.
// One row per date, supervisor-editable.
/// Shared holiday calendar — used by both the Marketing holiday-calendar
/// page (skips entries when computing working days for Lead Pulse) and
/// the HR side (treated as paid holiday in attendance + salary). Both
/// modules read and write this table, gated by their own role checks.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  label       String
  notes       String?
  /// Whether the holiday is paid (default true). Currently every entry
  /// is paid; the flag exists for future "unpaid optional holiday" use.
  paid        Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(name: "HolidaysCreated", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation(name: "HolidaysUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// Master: parties (candidates / vendors) referenced by transactions.
model Party {
  id              String           @id @default(cuid())
  name            String           @unique
  // 'Candidate' | 'Vendor'
  group           String
  // What transaction types this party may be linked to: 'Revenue' | 'Expense' | 'Both'
  txTypes         String           @default("Both")
  email           String?
  phone           String?
  notes           String?
  isActive        Boolean          @default(true)
  // Source (lead origin) — only meaningful for Candidates. Pulls from
  // LeadPulseSource so the dropdown stays in sync with the marketing
  // module's source list.
  sourceId        String?
  source          LeadPulseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // L2 BDE who closed this candidate. Populated by Suhaina (or any
  // supervisor) on the candidate detail page; drives the service-
  // conversion matrix on /marketing/lead-pulse/targets.
  assignedL2BdeId String?
  assignedL2Bde   User?            @relation(name: "PartyAssignedL2Bde", fields: [assignedL2BdeId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions      Transaction[]
  transactionDrafts TransactionDraft[]
  // Legacy implicit M:M kept for backwards compatibility — new UI uses
  // partyServices (with totalAmount). Will be removed once
  // migrate-party-services has been run everywhere.
  services          Service[]
  partyServices     PartyService[]
  pipelineRows      LeadPulsePipeline[] @relation("PartyPipeline")
  collectionPlans   CollectionPlan[]
  leads             Lead[]              @relation("LeadParty")
  opsProjects       OpsProject[]

  @@index([group])
  @@index([isActive])
  @@index([sourceId])
  @@index([assignedL2BdeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model PendingApproval {
  id            String       @id @default(cuid())
  kind          String // "create" | "update" | "delete"
  status        String       @default("pending") // "pending" | "approved" | "rejected"
  targetTxId    String?
  targetTx      Transaction? @relation("targetTransaction", fields: [targetTxId], references: [id], onDelete: SetNull)
  proposed      Json? // proposed transaction values (null for delete)
  submittedById String?
  submittedBy   User?        @relation("submittedApprovals", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?        @relation("reviewedApprovals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Back-link: when an installment is submitted to the approval queue
  /// the resulting PendingApproval row carries this FK so approve/reject
  /// can flip the installment status without scanning the queue.
  collectionInstallmentId String?                    @unique
  collectionInstallment   CollectionPlanInstallment? @relation("InstallmentPending", fields: [collectionInstallmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([targetTxId])
}

/// Personal "draft" transactions for users with User.draftFirst=true.
/// They never enter the approval queue until the user explicitly
/// submits them from the My Drafts page — at which point a normal
/// PendingApproval row is created and the draft is deleted.
model TransactionDraft {
  id            String   @id @default(cuid())
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  // Same fields as the canonical Transaction shape so the My Drafts
  // table can render and edit them in place.
  date          DateTime
  month         String
  type          String
  category      String
  subItem       String
  description   String?
  paymentMode   String
  amount        Decimal  @db.Decimal(14, 2)
  flow          String
  partyId       String?
  party         Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// Mirrors Transaction.employeeId — employee counterparty for
  /// salary / incentive outflow drafts.
  employeeId    String?
  employee      Employee? @relation("EmployeeTransactionDrafts", fields: [employeeId], references: [id], onDelete: SetNull)
  /// Mirrors Transaction.expDom — required on Revenue drafts.
  expDom        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([submittedById])
  @@index([createdAt])
  @@index([employeeId])
}

/// Metadata about each Voxbay CSV upload. The actual call rows live
/// in VoxbayCall. New rows in an upload are merged in; existing rows
/// that don't appear in the new CSV are preserved (a partial export
/// won't wipe historical data).
model VoxbayUpload {
  id           String   @id @default(cuid())
  uploadedById String?
  uploadedBy   User?    @relation(name: "VoxbayUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  filename     String?
  rowCount     Int      @default(0)
  uploadedAt   DateTime @default(now())

  @@index([uploadedAt])
}

/// One parsed row from the Voxbay incoming-call report. Durations
/// are normalised to seconds for analytics; the original HH:MM:SS
/// string is preserved on `*Display` for the table.
model VoxbayCall {
  id                      String    @id @default(cuid())
  /// Deterministic identity key for merge-on-upload semantics:
  /// `${sourceNumber}|${didNumber}|${callStartTime.toISOString()}`.
  /// Nullable for legacy rows; populated by the upload route + a
  /// backfill DDL step.
  signature               String?   @unique
  slNo                    Int?
  contactName             String?
  sourceNumber            String?
  didNumber               String?
  cost                    Float?
  dtmfSeq                 String?
  callStartTime           DateTime?
  callConnectedTime       DateTime?
  callStatus              String?
  userStatus              String?
  stickyStatus            String?
  holdTime                String?
  callRecordFile          String?
  application             String?
  extNumber               String?
  appName                 String?
  agentName               String?
  lastTriedName           String?
  firstTriedName          String?
  totalDurationSec        Int       @default(0)
  totalDurationDisplay    String?
  answeredDurationSec     Int       @default(0)
  answeredDurationDisplay String?
  deptName                String?
  disposition             String?
  latestComment           String?
  createdAt               DateTime  @default(now())

  @@index([callStartTime])
  @@index([callStatus])
  @@index([userStatus])
  @@index([agentName])
  @@index([lastTriedName])
}

/// One per (BDE, year, month) row holding the AI-style coaching loop
/// shown on the BDE performance page. The system writes the initial
/// analysis + 3 questions; the BDE writes their answers; the system
/// writes follow-up feedback. Admins can read everyone's; BDEs only
/// see their own.
model LeadPulseBdeInsight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(name: "BdeInsights", fields: [userId], references: [id], onDelete: Cascade)
  year   Int
  month  Int

  /// Initial markdown analysis the BDE reads before answering.
  analysis  String
  /// JSON: Array<{ id: string; question: string; hint?: string }>.
  questions Json
  /// JSON: Record<string, string>  (question id → BDE's answer).
  answers   Json?
  /// Follow-up markdown feedback written after answers are submitted.
  feedback  String?

  /// 'draft' before BDE answers, 'answered' once submitted.
  status     String    @default("draft")
  answeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
}

/// A collection plan: N expected installments (CollectionPlanInstallment)
/// against a candidate (Party). Created by a Finance Executive on the
/// /finance/collection-plan page so receivables can be staged ahead of
/// time. Each installment can be submitted to the Daily Tracker for
/// approval, at which point a normal Transaction (or PendingApproval)
/// is created and linked back to the installment via the installment's
/// pendingApprovalId / transactionId fields.
model CollectionPlan {
  id          String   @id @default(cuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Optional service this plan corresponds to (e.g. AHPRA, PR).
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  label       String
  /// Default category / sub-item / payment-mode the installments inherit
  /// when none is explicitly set on the installment row. Captured at
  /// submit-to-Daily-Tracker time rather than plan-create time, so all
  /// four are nullable until an installment is actually pushed through.
  category    String?
  subItem     String?
  paymentMode String?
  /// EXP / DOM tag for Revenue rows. Picked at submit time too.
  expDom      String?
  notes       String?
  status      String   @default("active") // 'active' | 'closed' | 'cancelled'
  createdById String?
  createdBy   User?    @relation("CollectionPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments CollectionPlanInstallment[]

  @@index([partyId])
  @@index([serviceId])
  @@index([status])
  @@index([createdById])
}

/// One expected installment line on a CollectionPlan.
model CollectionPlanInstallment {
  id                String           @id @default(cuid())
  planId            String
  plan              CollectionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 1-based ordering inside the plan. Unique per plan.
  seq               Int
  expectedDate      DateTime         @db.Date
  amount            Decimal          @db.Decimal(14, 2)
  /// Optional per-installment overrides; fall back to plan defaults when null.
  category          String?
  subItem           String?
  paymentMode       String?
  description       String?
  /// 'pending'    — staged, not yet pushed to daily tracker.
  /// 'submitted'  — waiting on supervisor in the approval queue.
  /// 'received'   — approved + transaction row exists.
  /// 'cancelled'  — installment scrapped (no transaction).
  status            String           @default("pending")
  /// FK back to the active PendingApproval row (if status='submitted').
  pendingApprovalId String?          @unique
  pending           PendingApproval? @relation("InstallmentPending")
  /// FK to the canonical Transaction (if status='received').
  transactionId     String?          @unique
  transaction       Transaction?     @relation("InstallmentTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([planId, seq])
  @@index([planId])
  @@index([status])
  @@index([expectedDate])
}

// ──────────────────────────────────────────────────────────────────────
// HR module
// ──────────────────────────────────────────────────────────────────────

model HrShift {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  startTime         String
  endTime           String
  graceMinutes      Int                 @default(0)
  halfDayCutoffTime String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  employees         Employee[]
  assignments       HrShiftAssignment[]

  @@index([active])
}

model Employee {
  id                 String         @id @default(cuid())
  empCode            String         @unique
  name               String
  dob                DateTime?      @db.Date
  /// Optional photo URL (e.g. /uploads/employees/<id>.jpg). Used by the
  /// Birthday Calendar widget and ESS profile avatar.
  photoUrl           String?
  /// Free-text legacy designation (preserved during migration). New
  /// rows should set `designationId` instead, but this column stays
  /// readable so historical CSV exports keep working.
  designation        String?
  /// Free-text legacy primary department. Superseded by the
  /// HrEmployeeDepartment many-to-many (isPrimary=true).
  department         String?
  /// FK into HrDesignation — defines the employee's tier in the org
  /// hierarchy.
  designationId      String?
  designationRef     HrDesignation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  email              String?
  officialEmail      String?
  phone              String?
  emergencyContact   String?
  officeNumber       String?
  address            String?
  highestEducation   String?
  maritalStatus      String?
  experienceNotes    String?
  yearsOfExperience  String?
  aadhar             String?
  pan                String?
  accountNumber      String?
  ifsc               String?
  bankName           String?
  branch             String?
  joinDate           DateTime?      @db.Date
  /// Legacy single-shift FK. New code must use HrShiftAssignment +
  /// resolveShiftForDate() so old payroll cycles keep using the shift
  /// that applied at the time of the cycle even after future shift
  /// changes. Kept as a denormalised "current shift" cache.
  shiftId            String?
  shift              HrShift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  /// Reporting manager (FK to another Employee). Drives the org chart
  /// reporting-line on the ESS profile page.
  reportsToId        String?
  reportsTo          Employee?      @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports            Employee[]     @relation("EmployeeReportsTo")
  halfHourConcession Boolean        @default(false)
  active             Boolean        @default(true)
  userId             String?        @unique
  user               User?          @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryStructures     HrSalaryStructure[]
  attendanceDays       HrAttendanceDay[]
  leaveBalances        HrLeaveBalance[]
  leaveRequests        HrLeaveRequest[]
  salaryLines          HrSalaryRunLine[]
  salaryAdjustments    HrSalaryAdjustment[]
  policyAcks           HrPolicyAcknowledgement[]
  trainingProgress     HrTrainingProgress[]
  notificationReceipts HrNotificationReceipt[]
  departments          HrEmployeeDepartment[]
  roleMemberships      HrEmployeeRole[]
  /// Departments this employee heads (zero, one, or many).
  headOfDepartments    HrDepartment[]            @relation("HrDepartmentHead")
  psychAssignments     PsychAssignment[]
  psychReports         PsychReport[]
  shiftAssignments     HrShiftAssignment[]
  leaveEligibility     HrLeaveEligibility?
  leaveAccruals        HrLeaveAccrual[]
  regularizations      HrAttendanceRegularization[] @relation("RegEmployee")
  attendanceScoreSignals HrAttendanceScoreSignal[]
  birthdayWishes       HrBirthdayWish[]          @relation("BirthdayRecipient")
  /// Finance transactions/drafts where this employee is the counterparty
  /// (salary / incentive outflows).
  transactions         Transaction[]             @relation("EmployeeTransactions")
  transactionDrafts    TransactionDraft[]        @relation("EmployeeTransactionDrafts")

  @@index([active])
  @@index([shiftId])
  @@index([department])
  @@index([designationId])
  @@index([reportsToId])
}

/// Designation = seniority tier (e.g. Director, Sr. Manager, Manager,
/// Asst. Manager, Sr. Executive, Executive, Trainee). `level` is the
/// numeric rank — higher number = more senior. The Org Chart sorts
/// employees inside each department by descending level.
model HrDesignation {
  id        String     @id @default(cuid())
  name      String     @unique
  /// Higher = more senior. Used for tier ordering in the org chart.
  level     Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@index([active])
  @@index([level])
}

/// Functional / business department (e.g. Sales, HR, Finance,
/// Documentation). Each can have a head; employees join via the
/// HrEmployeeDepartment M:M with one flagged primary.
model HrDepartment {
  id              String                 @id @default(cuid())
  name            String                 @unique
  description     String?
  headEmployeeId  String?
  headEmployee    Employee?              @relation("HrDepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  members         HrEmployeeDepartment[]
  sandwichPolicy  HrSandwichPolicy[]

  @@index([active])
}

/// M:M join: Employee ↔ Department. Exactly one row per (employee,
/// department) pair may have isPrimary=true — enforced at the API
/// layer (Prisma can't express the "exactly-one" constraint).
model HrEmployeeDepartment {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId String
  department   HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isPrimary    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@unique([employeeId, departmentId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([employeeId, isPrimary])
}

/// Functional role / specialty (e.g. BDE L1, BDE L2, Counsellor,
/// Tele Marketing, Voxbay Admin). Free-form — HR adds rows as needed.
model HrRole {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     HrEmployeeRole[]

  @@index([active])
}

/// M:M join: Employee ↔ Role.
model HrEmployeeRole {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     String
  role       HrRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, roleId])
  @@index([employeeId])
  @@index([roleId])
}

/// Per-employee salary structure. Basic is the primary input; HRA /
/// Conveyance / Medical / Special are stored as % of Basic and default
/// to the company-wide template (40 / 20 / 25 / 15). Gross is therefore
/// always derivable as Basic × (1 + sum(pcts)/100) — by default 2×.
/// PT defaults to the Kerala slab for the gross at insert-time; HR can
/// override.
model HrSalaryStructure {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime @db.Date
  /// Basic salary (₹ / month) — primary input. Everything else derives.
  basic           Decimal  @db.Decimal(12, 2)
  hraPct          Decimal  @default(40) @db.Decimal(5, 2)
  conveyancePct   Decimal  @default(20) @db.Decimal(5, 2)
  medicalPct      Decimal  @default(25) @db.Decimal(5, 2)
  specialPct      Decimal  @default(15) @db.Decimal(5, 2)
  esiApplicable   Boolean  @default(true)
  pfApplicable    Boolean  @default(true)
  /// Override Kerala PT slab if needed. Default 125 (₹125/mo slab).
  professionalTax Decimal  @default(125) @db.Decimal(8, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId])
  @@index([effectiveFrom])
}

model HrLeavePolicy {
  id                String   @id @default(cuid())
  name              String   @unique
  monthlyAccrual    Decimal  @default(1) @db.Decimal(4, 2)
  annualEntitlement Decimal  @default(12) @db.Decimal(5, 2)
  carryForward      Boolean  @default(true)
  carryForwardCap   Decimal  @default(0) @db.Decimal(5, 2)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HrLeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  opening    Decimal  @default(0) @db.Decimal(5, 2)
  accrued    Decimal  @default(0) @db.Decimal(5, 2)
  used       Decimal  @default(0) @db.Decimal(5, 2)
  balance    Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([employeeId, year])
  @@index([year])
}

model HrLeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  days         Decimal   @db.Decimal(5, 2)
  leaveType    String    @default("CL")
  reason       String?
  status       String    @default("pending")
  reviewedById String?
  reviewedBy   User?     @relation("HrLeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, fromDate])
  @@index([status])
}

// (HrHoliday was unified into the shared `Holiday` model — both Marketing
//  and HR now read/write the same table.)

model HrAttendanceUpload {
  id           String            @id @default(cuid())
  filename     String?
  monthKey     String
  rowCount     Int               @default(0)
  uploadedById String?
  uploadedBy   User?             @relation("HrUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime          @default(now())
  notes        String?
  days         HrAttendanceDay[]

  @@index([monthKey])
  @@index([uploadedAt])
}

model HrAttendanceDay {
  id              String             @id @default(cuid())
  uploadId        String
  upload          HrAttendanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime           @db.Date
  shiftCode       String? // "G", "X", "C" etc from biometric report
  inTime          String?
  outTime         String?
  /// Minutes worked excluding OT (i.e. Work+OT - OT in the source file).
  workMinutes     Int?
  breakMinutes    Int?
  otMinutes       Int?
  lateMinutes     Int?
  earlyOutMinutes Int?
  /// Normalised status: P | A | WO | HL | LV | HD. HD is derived on upload when
  /// status=P but the punch-based worked duration is under the half-day bar
  /// (weekday < 7h / Saturday < 5.5h), where the out-time is capped at the shift
  /// end (weekday: resolved shift end; Saturday: 16:00). HR can later override
  /// via regularization; the original biometric value is preserved in
  /// `rawStatus` for audit.
  status          String
  /// Free-text remark from the biometric report (e.g. "LT-EO", "MIS-LT-OT").
  remark          String?
  rawName         String?
  /// Original status from the biometric upload, before any HR override.
  /// Null on rows imported before this column existed (treat as same as
  /// `status` in that case).
  rawStatus       String?
  /// HR's classification note when overriding the leave decision.
  decisionNote    String?
  decidedById     String?
  decidedBy       User?              @relation("HrLeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

/// Score-only behavioural overlay for the Attendance Scorecard.
///
/// Holds the RAW biometric punch / late / early-out signals for a date. It is
/// read ONLY by the scorecard (hr-attendance-score*.ts), which overlays these
/// fields onto the corrected HrAttendanceDay row when scoring — so the score
/// reflects the employee's actual behaviour (late-comings, missing punches,
/// early departures) even after a corrected upload cleaned those signals out of
/// the attendance record. Presence (status) is NEVER taken from here: the
/// corrected HrAttendanceDay.status is authoritative for present/absent/half-day.
///
/// Payroll, leave balances and the attendance grid do NOT read this table, so it
/// can never affect pay. Populated for the Apr–Jun 2026 backfill (source =
/// "biometric_backfill_2026Q2"); from July 2026 employees regularise live, so
/// no signals are stored and the scorecard reads HrAttendanceDay directly.
model HrAttendanceScoreSignal {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  inTime          String?
  outTime         String?
  /// Late minutes recomputed against the resolved HR shift start (upload-route
  /// parity), so AL/LCE tags match how payroll would have charged them.
  lateMinutes     Int?
  earlyOutMinutes Int?
  /// Raw biometric status (P/A/WO/HD…) — audit/debug only, NOT used for presence.
  rawStatus       String?
  shiftCode       String?
  remark          String?
  /// Provenance tag, e.g. "biometric_backfill_2026Q2".
  source          String
  createdAt       DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

model HrSalaryRun {
  id              String            @id @default(cuid())
  monthKey        String            @unique
  workingDaysBase Int               @default(30)
  status          String            @default("draft")
  totalNet        Decimal           @default(0) @db.Decimal(14, 2)
  createdById     String?
  createdBy       User?             @relation("HrSalaryRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?             @relation("HrSalaryRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  axisExportName  String?
  axisExportedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lines           HrSalaryRunLine[]
  adjustments     HrSalaryAdjustment[]

  @@index([status])
}

model HrSalaryRunLine {
  id               String      @id @default(cuid())
  runId            String
  run              HrSalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  totalWorkingDays Decimal     @db.Decimal(5, 2)
  daysAttended     Decimal     @db.Decimal(5, 2)
  paidLeave        Decimal     @default(0) @db.Decimal(5, 2)
  unpaidLeave      Decimal     @default(0) @db.Decimal(5, 2)
  halfDayLeave     Decimal     @default(0) @db.Decimal(5, 2)
  totalLeaveForLop Decimal     @default(0) @db.Decimal(5, 2)
  monthlySalary    Decimal     @db.Decimal(12, 2)
  basicSalary      Decimal     @db.Decimal(12, 2)
  basicAfterLop    Decimal     @db.Decimal(12, 2)
  dailyBasis       Decimal     @db.Decimal(12, 2)
  salaryBeforeEsi  Decimal     @db.Decimal(12, 2)
  esiEmployee      Decimal     @default(0) @db.Decimal(10, 2)
  pfEmployee       Decimal     @default(0) @db.Decimal(10, 2)
  professionalTax  Decimal     @default(0) @db.Decimal(10, 2)
  netSalary        Decimal     @db.Decimal(12, 2)
  esiEmployer      Decimal     @default(0) @db.Decimal(10, 2)
  pfEmployer       Decimal     @default(0) @db.Decimal(10, 2)
  esiTotal         Decimal     @default(0) @db.Decimal(10, 2)
  pfTotal          Decimal     @default(0) @db.Decimal(10, 2)
  /// Cached net effect of this employee's non-penalty HrSalaryAdjustment rows
  /// (Σ additions − Σ non-penalty deductions). Penalty deductions are NOT here —
  /// they reduce the pre-statutory salary and are baked into the statutory
  /// columns above. Recomputed by computeSalaryRun; downstream (run total, Axis
  /// export, slip) uses `netSalary + adjustments`. `adjustmentNote` is legacy.
  adjustments      Decimal     @default(0) @db.Decimal(10, 2)
  adjustmentNote   String?
  bankAccount      String?
  bankIfsc         String?
  bankName         String?
  bankBranch       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([runId, employeeId])
  @@index([employeeId])
}

/// Itemised, ad-hoc pay corrections for one employee within one salary run
/// (advance recovery, loan EMI, penalty, incentive, arrears, reimbursement…).
/// Keyed by (run, employee) — NOT by run-line — so a Recompute, which deletes
/// and re-creates every HrSalaryRunLine, does not wipe them. Only editable while
/// the run is `draft`.
///
/// Money model:
///   kind = "deduction", category "penalty" → reduces the salary BEFORE
///          ESI/PF/PT (treated as monetary loss-of-pay: gross + basic shrink
///          proportionally, so ESI/PF recompute on the reduced figures).
///   kind = "deduction", other category      → post-net take-home reduction.
///   kind = "addition"                        → paid on top of the final net.
/// `amount` is always stored positive; the sign is implied by `kind`.
model HrSalaryAdjustment {
  id          String      @id @default(cuid())
  runId       String
  run         HrSalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "deduction" (penalty = pre-statutory, others = post-net) | "addition"
  kind        String
  /// advance | loan | penalty | arrears | incentive | bonus | reimbursement | other
  category    String
  /// Always positive; sign implied by `kind`.
  amount      Decimal     @db.Decimal(10, 2)
  note        String?
  createdById String?
  createdBy   User?       @relation("HrSalaryAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([runId, employeeId])
  @@index([employeeId])
}

model HrPolicy {
  id            String                    @id @default(cuid())
  title         String
  version       String                    @default("v1")
  body          String
  externalUrl   String?
  category      String?
  status        String                    @default("draft")
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?                     @relation("HrPolicyPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  requiresAck   Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  acks          HrPolicyAcknowledgement[]

  @@index([status])
}

model HrPolicyAcknowledgement {
  id             String   @id @default(cuid())
  policyId       String
  policy         HrPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signatureName  String
  signatureImage String?
  ipAddress      String?
  userAgent      String?
  signedAt       DateTime @default(now())

  @@unique([policyId, employeeId])
  @@index([employeeId])
}

model HrTraining {
  id           String               @id @default(cuid())
  title        String
  description  String?
  videoUrl     String?
  quiz         Json?
  passingScore Int                  @default(70)
  status       String               @default("draft")
  createdById  String?
  createdBy    User?                @relation("HrTrainingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  progress     HrTrainingProgress[]

  @@index([status])
}

model HrTrainingProgress {
  id          String     @id @default(cuid())
  trainingId  String
  training    HrTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  watchedPct  Int        @default(0)
  score       Int?
  attempts    Int        @default(0)
  passed      Boolean    @default(false)
  answers     Json?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([trainingId, employeeId])
  @@index([employeeId])
}

model HrNotification {
  id          String                  @id @default(cuid())
  title       String
  body        String
  linkUrl     String?
  kind        String                  @default("announcement")
  requiresAck Boolean                 @default(false)
  createdById String?
  createdBy   User?                   @relation("HrNotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  receipts    HrNotificationReceipt[]

  @@index([kind])
}

model HrNotificationReceipt {
  id             String         @id @default(cuid())
  notificationId String
  notification   HrNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime       @default(now())

  @@unique([notificationId, employeeId])
  @@index([employeeId])
  @@index([acknowledgedAt])
}

model HrAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("HrAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType   String
  entityType  String?
  entityId    String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([eventType])
  @@index([occurredAt])
  @@index([actorUserId])
}

// ──────────────────────────────────────────────────────────────────────
// Multi-shift assignment with effective date ranges.
//
// Why: the legacy `Employee.shiftId` is a single FK — changing it
// retroactively breaks attendance/overtime/payroll for prior cycles.
// HrShiftAssignment lets HR layer multiple shift periods on a single
// employee. `resolveShiftForDate()` (in lib/hr-shift.ts) picks the
// right one for any historical date.
//
// `effectiveTo` is nullable — null means "still in effect". The API
// layer enforces non-overlap and auto-closes the previous open period
// when a new one is added.
// ──────────────────────────────────────────────────────────────────────

model HrShiftAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         HrShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime  @db.Date
  /// Null = open-ended (still in effect). Closed when a later
  /// assignment is added.
  effectiveTo   DateTime? @db.Date
  /// HR-supplied reason for the change (e.g. "Promoted to evening
  /// floor", "Cycle-end relief"). Surfaces in the shift history log.
  reason        String?
  /// 'pending' until reviewed; 'approved' once an HR Manager signs
  /// off; 'rejected' if denied. Only approved rows are honoured by
  /// resolveShiftForDate().
  status        String    @default("approved")
  createdById   String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
}

// ──────────────────────────────────────────────────────────────────────
// Per-employee monthly leave eligibility.
//
// Replaces the implicit "everyone accrues 1/mo" assumption with an
// explicit per-employee toggle. When enabled, the monthly-accrual job
// (POST /api/hr/leave/run-accrual) credits `leavesPerMonth` to the
// employee's HrLeaveBalance for the current cycle and writes an
// HrLeaveAccrual ledger row.
// ──────────────────────────────────────────────────────────────────────

model HrLeaveEligibility {
  id              String    @id @default(cuid())
  employeeId      String    @unique
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  /// 'monthly' is the only supported value today; reserved for future
  /// quarterly / annual schedules.
  frequency       String    @default("monthly")
  /// Date from which accrual kicks in.
  effectiveFrom   DateTime  @db.Date
  leavesPerPeriod Decimal   @default(1) @db.Decimal(4, 2)
  /// Default leave type credited (CL / SL / PL).
  leaveType       String    @default("CL")
  /// When true, any unused balance carries forward to next year up
  /// to `carryForwardCap`. When false, year-end balance resets to 0.
  carryForward    Boolean   @default(true)
  carryForwardCap Decimal   @default(0) @db.Decimal(5, 2)
  /// Optional months after which credited but unused leaves expire.
  expiryMonths    Int?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
}

/// Ledger row written every time the accrual job credits leave to an
/// employee, or HR makes a manual adjustment. Lets the leave-balance
/// page show full history.
model HrLeaveAccrual {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodKey   String
  /// Positive for credit, negative for debit/adjustment.
  delta       Decimal  @db.Decimal(5, 2)
  /// 'auto'      — scheduled accrual job
  /// 'manual'    — HR adjustment (additive delta)
  /// 'allocation'— HR's per-(cycle)-month paid-leave allocation; one row per
  ///               month (periodKey 'YYYY-MM'), delta = the set value, and it
  ///               overrides the eligibility auto-accrual for that month
  /// 'expiry'    — system-driven expiry
  /// 'opening'   — year-rollover opening balance
  source      String
  leaveType   String   @default("CL")
  reason      String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, periodKey, source])
  @@index([employeeId, createdAt])
  @@index([periodKey])
}

// ──────────────────────────────────────────────────────────────────────
// Attendance regularization workflow.
//
// Employees use POST /api/me/regularization to flag a missed punch /
// wrong time within 3 working days of the discrepancy. HR Managers
// review on /hr/regularization; approving sets HrAttendanceDay.status
// to "P" (or "HD") and writes the corrected times back, with a full
// audit trail.
// ──────────────────────────────────────────────────────────────────────

model HrAttendanceRegularization {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation("RegEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  /// Optional FK to the attendance row this request corrects. Null if
  /// no attendance row was uploaded yet for this date.
  attendanceDayId String?
  date            DateTime         @db.Date
  /// What the employee is asking for:
  ///   'punch' → correct a missing/wrong punch (approval → P/HD)
  ///   'leave' → mark an absence as paid leave (approval → LV)
  requestType     String           @default("punch")
  /// For punch requests: 'missing_punch' | 'wrong_in_time' | 'wrong_out_time'
  /// | 'biometric_sync' | 'forgot_punch' | 'other'. For leave requests: 'leave'.
  reasonType      String
  reason          String
  proposedIn      String?
  proposedOut     String?
  /// Optional uploaded artefact (e.g. screenshot URL).
  attachmentUrl   String?
  status          String           @default("pending")
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([employeeId, date])
  @@index([status, createdAt])
}

// ──────────────────────────────────────────────────────────────────────
// Sandwich-leave policy.
//
// When configured, intermediate week-offs/holidays sandwiched between
// two leave days are counted as leave (LOP). Each row scopes the
// policy globally or to a single department.
// ──────────────────────────────────────────────────────────────────────

model HrSandwichPolicy {
  id           String        @id @default(cuid())
  /// Null = company-wide. Set to scope to a single department.
  departmentId String?
  department   HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  enabled      Boolean       @default(true)
  /// Treat intermediate holidays as leave when bracketed by leave.
  includeHolidays Boolean    @default(true)
  /// Treat intermediate week-offs as leave when bracketed by leave.
  includeWeekOffs Boolean    @default(true)
  /// Maximum gap (days) between the two bracketing leave days for
  /// the sandwich rule to apply. 7 covers a typical week.
  maxGapDays   Int           @default(7)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([departmentId])
  @@index([enabled])
}

// ──────────────────────────────────────────────────────────────────────
// Birthday module — config + send log.
// ──────────────────────────────────────────────────────────────────────

model HrBirthdaySettings {
  id              String   @id @default(cuid())
  /// Singleton row — enforced via `@@unique([singleton])`.
  singleton       Boolean  @unique @default(true)
  /// Send the auto-generated wish on the birthday morning.
  autoWishEnabled Boolean  @default(false)
  /// Reminder N days in advance (0 = day-of only).
  reminderDays    Int      @default(1)
  /// Send via email, whatsapp, both, or none ("disabled").
  channel         String   @default("email")
  /// Template used for the auto-wish (supports {{name}}, {{dept}}).
  template        String   @default("Happy birthday, {{name}}! Wishing you a wonderful year ahead. — Team DESGRO")
  updatedAt       DateTime @updatedAt
}

/// One row per (employee, year) when the system sends a birthday
/// wish. Prevents duplicate sends and lets HR review the send log.
model HrBirthdayWish {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation("BirthdayRecipient", fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int
  channel     String
  status      String   @default("sent")
  payload     Json?
  sentAt      DateTime @default(now())

  @@unique([employeeId, year])
  @@index([year])
}

// ──────────────────────────────────────────────────────────────────────
// ESS credential generation log — one row per (employee, generation
// event). Used so HR can re-issue and the audit page can show who
// generated/reset credentials when.
// ──────────────────────────────────────────────────────────────────────

model HrEssCredentialEvent {
  id          String   @id @default(cuid())
  employeeId  String
  /// 'create' | 'reset' | 'disable'
  action      String
  username    String
  channel     String?
  /// Hash of the temporary password sent — for audit only, never the
  /// raw password.
  tempPasswordHash String?
  actorUserId String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// HR Psychometric Assessment (OCEAN / Big-Five) — Phase 1
// Tokens are stored hashed; raw UUID is shown to HR once at assignment time
// and never persisted in the DB.
// ─────────────────────────────────────────────────────────────────────────────

enum PsychDimension {
  O
  C
  E
  A
  N
  VALIDITY
}

enum PsychStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  INVALIDATED
}

model PsychTest {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  createdById String?
  createdBy   User?             @relation("PsychTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  questions   PsychQuestion[]
  assignments PsychAssignment[]

  @@index([active])
}

model PsychQuestion {
  id             String          @id @default(cuid())
  testId         String
  test           PsychTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  /// 1-based display order within the test.
  order          Int
  dimension      PsychDimension
  textEn         String
  /// Malayalam translation; null until HR fills it in via the question editor.
  textMl         String?
  /// If true, the response is reverse-scored before being summed into its
  /// dimension (i.e. raw 5 → effective 1 for a positively-worded summary).
  reverseScored  Boolean         @default(false)
  /// Two questions sharing the same `validityPairId` are paired for the
  /// internal consistency check (only used when dimension = VALIDITY).
  validityPairId String?
  active         Boolean         @default(true)
  responses      PsychResponse[]

  @@unique([testId, order])
  @@index([testId, dimension])
  @@index([validityPairId])
}

model PsychAssignment {
  id            String          @id @default(cuid())
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  testId        String
  test          PsychTest       @relation(fields: [testId], references: [id], onDelete: Restrict)
  /// SHA-256 hex of (rawToken + tokenSalt). The raw UUID is shown to HR
  /// exactly once when the assignment is created — we never store it.
  tokenHash     String          @unique
  tokenSalt     String
  status        PsychStatus     @default(ASSIGNED)
  expiresAt     DateTime
  assignedAt    DateTime        @default(now())
  assignedById  String?
  assignedBy    User?           @relation("PsychAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  submittedAt   DateTime?
  /// SHA-256 hex of the requester IP captured at first GET — used for
  /// fraud diagnostics, not raw IP storage.
  ipHash        String?
  /// Increments on every /api/psych/test/[token] GET — rate-limit counter.
  startAttempts Int             @default(0)
  responses     PsychResponse[]
  report        PsychReport?

  @@index([employeeId])
  @@index([testId])
  @@index([status])
  @@index([expiresAt])
}

model PsychResponse {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   PsychAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     PsychQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  value        Int
  savedAt      DateTime        @default(now())

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
}

model PsychReport {
  id              String          @id @default(cuid())
  assignmentId    String          @unique
  assignment      PsychAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Raw per-dimension sums { O, C, E, A, N }.
  oceanRaw        Json
  /// Normalized 0–100 per dimension { O, C, E, A, N }.
  oceanNormalized Json
  /// Percentile rank (0–100) vs running internal norms { O, C, E, A, N }.
  oceanPercentile Json
  attitudeIndex   Int
  /// "Needs Attention" | "Moderate" | "Positive Attitude"
  attitudeClass   String
  profileType     String
  profileLabel    String
  /// Array of { code, label, severity, hrAction }.
  riskFlags       Json
  /// Array of strings.
  recommendations Json
  validityPassed  Boolean
  validityNotes   String?
  durationSeconds Int?
  /// Array of strings — e.g. ["RUSHED"].
  suspiciousFlags Json
  generatedAt     DateTime        @default(now())

  @@index([employeeId])
  @@index([generatedAt])
}

/// BDE incentive calculator — one editable plan per period (e.g. "June 2026").
/// Pure planning tool: Finance edits the rules + roster and the payout
/// recomputes live on the client; this model just persists that working state
/// so it survives reloads and is shared across the team.
model IncentivePlan {
  id              String         @id @default(cuid())
  /// Human period label, e.g. "June 2026". One plan per period.
  period          String         @unique
  /// ₹ per enrolment below the boost threshold.
  baseRate        Int            @default(1000)
  /// Enrolment count at/above which every enrolment pays the boosted rate.
  /// Float — enrolments can be fractional (e.g. .5 for some services).
  boostThreshold  Float          @default(16)
  /// ₹ per enrolment once the boost threshold is reached.
  boostRate       Int            @default(1500)
  /// Flat ₹ bonus when a BDE hits their individual target.
  individualBonus Int            @default(5000)
  /// ₹ per lead closed within 48 hours.
  fastBonus       Int            @default(250)
  /// ₹ per self-sourced candidate reference closed.
  refBonus        Int            @default(100)
  /// Combined enrolments across all BDEs that unlock the team pool.
  teamTarget      Float          @default(30)
  /// ₹ pool released when the team target is met.
  teamPool        Int            @default(15000)
  /// Team-pool split: "equal" | "enrolments" | "achievers".
  distMethod      String         @default("equal")
  /// When true, a BDE earns ₹0 enrolment incentive until they clear their minimum.
  requireMin      Boolean        @default(false)
  /// User id of whoever last saved this plan (loose ref — no FK so the User
  /// model needs no back-relation).
  updatedById     String?
  bdes            IncentiveBde[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

/// A single BDE row within an IncentivePlan.
model IncentiveBde {
  id        String        @id @default(cuid())
  planId    String
  plan      IncentivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String
  /// Minimum enrolments expected of this BDE. Float — supports .5 enrolments.
  minimum   Float         @default(8)
  /// Individual target — hitting it pays individualBonus.
  target    Float         @default(14)
  /// Enrolments achieved this period (may be fractional, e.g. 12.5).
  enrol     Float         @default(0)
  /// Leads closed within 48 hours.
  fast48    Int           @default(0)
  /// Self-sourced references closed.
  selfRef   Int           @default(0)
  /// Display order within the roster.
  sortIndex Int           @default(0)

  @@index([planId])
}

// ── CRM: individual inbound leads ───────────────────────────────────────────
// The CRM module tracks per-lead records (modelled on the Dynamics 365 Sales
// "Opportunity" view). It reuses Marketing masters (LeadPulseSource, Service)
// and BDE identity (LeadPulseRole) but keeps its own per-lead tables separate
// from Lead Pulse's aggregate daily-metrics tables.

model Lead {
  id String @id @default(cuid())

  // Core identity (shown as Excel-like columns)
  candidateName String
  email         String?
  // Raw phone as captured, plus a normalised E.164 used for wa.me / tel links.
  phone         String?
  phoneE164     String?
  // Optional secondary contact number (same raw + normalised E.164 pair as the
  // primary phone). Captured/displayed/searchable like `phone`, and ALSO part of
  // duplicate detection: a lead's phone identity is the set {phoneE164,
  // altPhoneE164}, matched against both fields on each side (so an alternate
  // number colliding with another lead's primary, or vice-versa, is detected).
  altPhone      String?
  altPhoneE164  String?

  // Classification (FKs to reusable masters)
  sourceId        String?
  source          LeadPulseSource?  @relation("LeadSource", fields: [sourceId], references: [id], onDelete: SetNull)
  // Preserved original acquisition source on a RE-ENROLLMENT lead. When an
  // existing candidate enrolls in a second service, the lead's primary `source`
  // is set to "Existing Candidate" (so repeat business shows as its own bucket
  // in the source funnel / reports) while `originalSource` keeps the channel the
  // candidate first came in through — so their original attribution is never
  // lost. Null on ordinary (first-time) leads.
  originalSourceId String?
  originalSource   LeadPulseSource? @relation("LeadOriginalSource", fields: [originalSourceId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  qualificationId String?
  qualification   CrmQualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)

  // Pipeline stage / disposition (admin-editable master)
  statusId String
  status   CrmLeadStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  // Assignment — the consultant (BDE) who owns this lead.
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // When the lead was assigned to its current consultant. Set on every
  // assign/reassign; cleared (null) on unassign. Drives the "Assigned" column
  // and the "assigned on <date>" filter.
  assignedAt   DateTime?

  // Optional linkage to the canonical candidate record once enrolled.
  partyId String?
  party   Party?  @relation("LeadParty", fields: [partyId], references: [id], onDelete: SetNull)

  // Deal: expected close date + value. Setting these mirrors the lead to a
  // LeadPulsePipeline row (1:1 below) so it feeds the Marketing "expected to
  // close" projection; on Enroll the pipeline flips to closed_won.
  expectedValue     Decimal?           @db.Decimal(14, 2)
  expectedCloseDate DateTime?          @db.Date
  pipelineId        String?            @unique
  pipeline          LeadPulsePipeline? @relation("LeadPipeline", fields: [pipelineId], references: [id], onDelete: SetNull)

  // Dedup keys. Detection matches an existing lead on emailKey OR phoneE164
  // independently (either collision flags a "Duplicate"). emailKey = lowercased
  // email; phoneE164 = normalised phone. Both plain (non-unique) indexes because
  // duplicates are flagged with a "Duplicate" status rather than dropped.
  // dedupeKey (legacy = email OR phone) is kept for provenance/back-compat.
  emailKey      String?
  dedupeKey     String?
  // Stable per-source-row key for idempotent external ingestion (e.g. a Meta
  // lead-ads spreadsheet row). Unique so a re-sent row is skipped, never
  // double-inserted. Null for manually-created leads.
  externalKey   String?          @unique
  importBatchId String?
  importBatch   LeadImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Campaign / spreadsheet tab the lead came from (e.g. a Meta campaign tab).
  // Promoted from extra.campaign so the leads list can filter & segment by it.
  campaign      String?

  // Candidate's official date of birth (date-only, no time). Age is NOT stored —
  // it's derived from `dob` at read time (see ageFromDob) so it's always current.
  // Backs the leads-list Age column and the age-range filter (translated to a dob
  // range in buildLeadWhere), and is shown/edited on the lead detail.
  dob           DateTime? @db.Date

  // Candidate's country (free-form name picked from the full country dropdown,
  // e.g. "India", "Australia"). Optional — drives the leads list country
  // column/filter and is shown/edited on the lead detail.
  country       String?

  // Preferred study-abroad DESTINATION (the country the candidate wants to study
  // in — e.g. "Australia", "United Kingdom"). Distinct from `country` (their home
  // country). Relevant only for the Study Abroad service; the lead form only
  // surfaces it for that service, but it's a plain column so the list can filter
  // & segment by it. Same free-form name from the country dropdown.
  studyDestination String?

  // Re-inquiry tracking. When a candidate who already exists submits again
  // (a duplicate by email/phone), we DON'T create a new row — we fold the
  // signal onto this canonical lead: bump `inquiryCount`, stamp `lastInquiryAt`,
  // log a RE_INQUIRY activity, and (if the lead was in a lost status) revive it
  // to Re-marketing. `inquiryCount` starts at 1 for the original submission.
  inquiryCount  Int       @default(1)
  lastInquiryAt DateTime?

  /// Free-form extras captured at import (region, campaign, city, age, …).
  /// JSON: Record<string, string>.
  extra Json?

  createdById    String?
  createdBy      User?    @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Drives "stale lead" sorting; bumped on every meaningful activity.
  lastActivityAt DateTime @default(now())

  notes      LeadNote[]
  activities LeadActivity[]
  tasks      CrmTask[]
  opsProjects OpsProject[] @relation("OpsProjectLead")

  @@index([assignedToId])
  @@index([assignedAt])
  @@index([statusId])
  @@index([sourceId])
  @@index([serviceId])
  @@index([qualificationId])
  @@index([partyId])
  @@index([originalSourceId])
  @@index([importBatchId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([dedupeKey])
  @@index([emailKey])
  @@index([campaign])
  @@index([dob])
  @@index([country])
  @@index([studyDestination])
  @@index([email])
  @@index([phoneE164])
  @@index([altPhoneE164])
  @@index([expectedCloseDate])
  @@index([lastInquiryAt])
}

// Admin-configurable pipeline stages / dispositions.
model CrmLeadStatus {
  id           String   @id @default(cuid())
  // 'not_yet_started' | 'qualify' | 'follow_up' | 'duplicate' | 'not_interested' | 'enrolled'
  code         String   @unique
  label        String
  // 'active' (shows on the stage bar) | 'won' | 'lost'
  kind         String   @default("active")
  displayOrder Int      @default(0)
  // Hex colour for the pill (optional).
  color        String?
  // The status new leads start in. Exactly one row should have this true.
  isDefault    Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]

  @@index([active])
  @@index([displayOrder])
}

model CrmQualification {
  id           String   @id @default(cuid())
  label        String   @unique
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]

  @@index([active])
  @@index([displayOrder])
}

// Per-lead notes (editable; edits are tracked as activities).
model LeadNote {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId, createdAt])
  @@index([authorId])
}

// Single source of truth for the Timeline AND the admin History tab.
model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  // See the taxonomy in src/lib/crm-activity.ts:
  // LEAD_CREATED | LEAD_IMPORTED | LEAD_OPENED | STATUS_CHANGED | FIELD_UPDATED |
  // ASSIGNED | REASSIGNED | UNASSIGNED | NOTE_ADDED | NOTE_EDITED | NOTE_DELETED |
  // EMAIL_SENT | WHATSAPP_SENT | CALL_LOGGED | PARTY_LINKED
  type       String
  // Human summary rendered in the timeline, e.g. "Status changed: Qualify → Follow Up".
  summary    String?
  /// Structured payload: { from, to, noteId, subject, channel, outcome, durationSec, … }.
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([leadId, occurredAt])
  @@index([type])
  @@index([actorId])
}

// Per-lead tasks / follow-ups (the Dynamics "Activities → Task" concept).
// Visible to anyone with CRM view access; mutated only by the assigned BDE or an
// admin (same canEditLead rule as notes/comms). Every change writes a
// TASK_* LeadActivity so it surfaces in the Timeline + admin History.
model CrmTask {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject       String
  dueAt         DateTime?
  // 'low' | 'normal' | 'high'
  priority      String    @default("normal")
  // 'open' | 'done'
  status        String    @default("open")
  note          String?
  // The consultant (BDE) responsible for the task.
  assignedToId  String?
  assignedTo    User?     @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?     @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?     @relation("CrmTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([leadId, status])
  // Supports a future cross-lead "My open tasks" / overdue view.
  @@index([assignedToId, status, dueAt])
  @@index([dueAt])
}

// Bulk-upload batches (for "X new, Y duplicates" reporting + provenance).
model LeadImportBatch {
  id            String   @id @default(cuid())
  fileName      String?
  uploadedById  String?
  uploadedBy    User?    @relation("LeadImportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  totalRows     Int      @default(0)
  insertedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  errorRows     Int      @default(0)
  // 'completed' | 'failed'
  status        String   @default("completed")
  createdAt     DateTime @default(now())
  leads         Lead[]

  @@index([createdAt])
  @@index([uploadedById])
}

// Generic admin-managed key/value settings (e.g. the lead-spreadsheet webhook
// secret), so integrations can be configured in-app instead of via env vars.
model AppSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedBy   User?    @relation("AppSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

/// Reusable email / WhatsApp message template authored in the CRM. Drives the
/// template pickers in the single-lead Email/WhatsApp composers and the bulk
/// email composer. Bodies (and email subjects) use `{token}` merge fields
/// (e.g. {name}, {service}, {consultant}) rendered at send time. Managed on
/// /crm/templates by system admins and roles granted that page (see
/// CRM_TEMPLATES_PAGE / canManageTemplates in src/lib/crm-rbac.ts).
model CrmMessageTemplate {
  id          String   @id @default(cuid())
  // "email" | "whatsapp" — which composer the template appears in.
  channel     String
  name        String
  // Email subject line (merge fields allowed). Null/unused for WhatsApp.
  subject     String?
  body        String
  // Inactive templates are hidden from the composers but kept for reference.
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CrmMessageTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channel, isActive])
  @@index([createdById])
}

// ──────────────────────────────────────────────────────────────────────
// Operations / Documentation module
//
// Tracks the documentation/process work Desma performs for an enrolled
// candidate. A "process" is the set of predefined steps for a Service
// (the TEMPLATE layer: ProcessTemplate + ProcessTemplateStep). When a
// candidate is enrolled in the CRM against a Service, the steps are
// snapshotted into a per-candidate project (the INSTANCE layer:
// OpsProject + OpsTask). An operations user is assigned to the project
// and completes the tasks. See src/lib/ops-rbac.ts + src/lib/ops-templates.ts.
// ──────────────────────────────────────────────────────────────────────

/// The reusable, admin-authored definition of a service's process. Exactly
/// one *active* template per Service; publishing a revision bumps `version`
/// and old versions are retained so historical OpsProject.templateId stays
/// valid. Authored on /operations/templates.
model ProcessTemplate {
  id          String                @id @default(cuid())
  serviceId   String
  service     Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name        String
  description String?
  isActive    Boolean               @default(true)
  version     Int                   @default(1)
  isSystem    Boolean               @default(false)
  createdById String?
  createdBy   User?                 @relation("OpsTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  steps       ProcessTemplateStep[]
  projects    OpsProject[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([serviceId, version])
  @@index([serviceId, isActive])
}

/// One predefined step in a process template, ordered by `seq`. `phase` is an
/// optional grouping label (e.g. "Initial" / "Mid" / "Final"). `slaDays` is
/// the business-day budget from project start, snapshotted onto each task.
model ProcessTemplateStep {
  id          String          @id @default(cuid())
  templateId  String
  template    ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  seq         Int
  name        String
  description String?
  phase       String?
  isRequired  Boolean         @default(true)
  slaDays     Int?
  tasks       OpsTask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([templateId, seq])
  @@index([templateId])
}

/// A per-candidate process instance — one per enrolled (candidate, service).
/// Keyed 1:1 on PartyService (the canonical "candidate enrolled with service"
/// row) so the CRM-enroll hook gets a natural idempotency key.
model OpsProject {
  id             String           @id @default(cuid())
  partyServiceId String           @unique
  partyService   PartyService     @relation(fields: [partyServiceId], references: [id], onDelete: Cascade)
  partyId        String
  party          Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  templateId     String?
  template       ProcessTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?            @relation("OpsProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  // Assignment — the operations user who owns this project.
  assignedToId   String?
  assignedTo     User?            @relation("OpsProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?

  // 'active' | 'on_hold' | 'completed' | 'cancelled'
  status         String           @default("active")
  startedAt      DateTime         @default(now())
  dueAt          DateTime?
  completedAt    DateTime?
  createdById    String?
  createdBy      User?            @relation("OpsProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastActivityAt DateTime         @default(now())

  // Provenance for one-time Odoo import; null for enroll-created projects.
  externalSource String?
  externalId     String?

  tasks          OpsTask[]
  activities     OpsTaskActivity[]
  actionItems    OpsActionItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([externalSource, externalId])
  @@index([assignedToId, status])
  @@index([status, dueAt])
  @@index([partyId])
  @@index([serviceId])
  @@index([templateId])
}

/// A single unit of work the operations user completes. Created by snapshotting
/// a ProcessTemplateStep at enroll (or imported from Odoo). The snapshot of
/// seq/name/phase/isRequired/slaDays freezes the task against later template
/// edits — the precondition for trustworthy performance analytics.
model OpsTask {
  id             String               @id @default(cuid())
  projectId      String
  project        OpsProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateStepId String?
  templateStep   ProcessTemplateStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)

  seq            Int
  name           String
  description    String?
  phase          String?
  isRequired     Boolean              @default(true)
  slaDays        Int?

  // 'pending' | 'in_progress' | 'completed' | 'blocked' | 'skipped'
  status         String               @default("pending")
  assignedToId   String?
  assignedTo     User?                @relation("OpsTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  completedById  String?
  completedBy    User?                @relation("OpsTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  blockedReason  String?
  notes          String?
  // Odoo task id for one-time import idempotency; null for enroll-created tasks.
  externalId     String?

  documents      OpsDocument[]
  activities     OpsTaskActivity[]
  actionItems    OpsActionItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([projectId, seq])
  @@unique([externalId])
  @@index([assignedToId, status, dueAt])
  @@index([status, completedAt])
  @@index([projectId])
}

/// An ad-hoc task ("Task" in the UI) a team member attaches to a step (OpsTask)
/// — the granular, assignable to-dos that live under the fixed process steps.
/// Distinct from OpsTask (the template-snapshotted "Step"): action items are
/// free-form, created on the fly, and assignable to a specific ops user so they
/// surface in that user's personal task folder (/operations/my-tasks). They are
/// advisory — an open action item never blocks its step or the project from
/// completing. `completedById` is stamped at completion, so attribution
/// survives project re-assignment (same pattern as OpsTask.completedBy).
model OpsActionItem {
  id            String     @id @default(cuid())
  projectId     String
  project       OpsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The step this task hangs off. Nullable so a project-level task is possible,
  // though v1 UI always attaches to a step.
  taskId        String?
  task          OpsTask?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  // 'open' | 'done' | 'cancelled'
  status        String     @default("open")
  assignedToId  String?
  assignedTo    User?      @relation("OpsActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt         DateTime?

  createdById   String?
  createdBy     User?      @relation("OpsActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?      @relation("OpsActionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([taskId])
  @@index([projectId])
}

/// Proof-of-completion evidence attached to a step (OpsTask). `fileUrl` is the
/// Vercel Blob URL. Images and PDFs are additionally run through Claude
/// (vision / document) to assess whether they support the step — the `ai*`
/// fields hold that assessment.
model OpsDocument {
  id           String   @id @default(cuid())
  taskId       String
  task         OpsTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  uploadedBy   User?    @relation("OpsDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  // AI analysis. status: 'pending' | 'processing' | 'done' | 'failed' | 'skipped'
  // (skipped = not an image/PDF, or AI not configured). verdict: 'supports' |
  // 'partial' | 'insufficient' | 'mismatch' | null.
  aiStatus     String    @default("skipped")
  aiVerdict    String?
  aiSummary    String?
  aiConcerns   String?
  aiFacts      Json?
  aiModel      String?
  aiAnalyzedAt DateTime?

  @@index([taskId])
}

/// Per-project/-task timeline + audit. Clone of LeadActivity. Performance
/// analytics attribute work via `actorId` (who actually did it), never the
/// current project assignee.
model OpsTaskActivity {
  id         String     @id @default(cuid())
  projectId  String
  project    OpsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       OpsTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?      @relation("OpsActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  // PROJECT_CREATED | ASSIGNED | REASSIGNED | STEP_STARTED | STEP_COMPLETED |
  // STEP_BLOCKED | STEP_SKIPPED | DOCUMENT_ADDED | NOTE_ADDED |
  // PROJECT_COMPLETED | IMPORTED
  type       String
  summary    String?
  metadata   Json?
  occurredAt DateTime   @default(now())

  @@index([projectId, occurredAt])
  @@index([actorId, type, occurredAt])
  @@index([type])
}

/// Active-engagement time per (user, module, page, day). Written by the client
/// heartbeat (src/components/UsageTracker.tsx) through POST /api/telemetry/activity,
/// which only credits seconds while the browser tab was VISIBLE *and* the user
/// interacted within the idle window (USAGE_IDLE_MS in src/lib/usage-tracking.ts).
/// "Just keeping the tab open" — hidden tab or no input — is never counted, so
/// this measures real engagement, not open-tab wall-clock.
///
/// Aggregated at day grain (one row per user × module × page × IST day) so the
/// table stays small and the usage dashboards query cheaply. `page` is the
/// registered page href from src/lib/modules.ts (e.g. "/crm/leads"), letting the
/// CRM view break time down by sub-page; `moduleId` is the owning module id
/// ("crm", "finance", …) or "unknown" for an unmatched path.
model ModuleUsageDaily {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserModuleUsage", fields: [userId], references: [id], onDelete: Cascade)
  moduleId      String
  page          String
  /// IST calendar day this bucket covers, stored at UTC midnight (see toPrismaDate).
  day           DateTime @db.Date
  /// Total active seconds credited to this bucket (atomically incremented).
  activeSeconds Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, moduleId, page, day])
  @@index([day, moduleId])
  @@index([userId, day])
  @@index([moduleId, day])
}
