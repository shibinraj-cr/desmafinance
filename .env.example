# Postgres connection string (Vercel Postgres / Neon / Supabase)
# Local dev tip: install Postgres or use https://neon.tech (free) and paste the connection URL here.
DATABASE_URL="postgresql://user:password@host:5432/desma?sslmode=require"

# NextAuth
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used for shareable links (e.g. the psychometric assignment
# link sent to employees). REQUIRED in production so links use the real domain
# instead of localhost. Leave unset locally to fall back to the dev host.
APP_BASE_URL="https://desgro.in"

# Initial admin user (created by `pnpm db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_EMAIL="admin@desma.local"

# Claude / Anthropic — powers the Lead Pulse Growth Planner AI recommendations
# and what-if answers. OPTIONAL: leave unset and the planner falls back to a
# built-in rule-based analysis. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-sonnet-4-6)
PLANNER_AI_MODEL="claude-sonnet-4-6"

# Shared secret for the lead-spreadsheet → CRM webhook
# (POST /api/integrations/sheet-leads — Meta lead-ads, Website/SEO, …).
# The Google Apps Script bound to each spreadsheet must send this exact value
# in the `x-webhook-secret` header. Generate one: openssl rand -base64 32
# Leave unset to disable the webhook (it returns 503). See integrations/sheet-leads/.
SHEET_LEADS_WEBHOOK_SECRET=""

# CRM email sender (single + bulk lead emails via Gmail SMTP).
# Prefer configuring this in-app: CRM → Settings → Integrations → "Email sender"
# (stored in AppSetting). These env vars are an optional fallback. EMAIL_SMTP_PASS
# is a Google App Password (needs 2-Step Verification), NOT the account password.
# A message sent via smtp.gmail.com is auto-filed in this account's Sent folder.
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM_NAME=""
EMAIL_FROM_ADDRESS=""

# ── eTimeOffice / Team Office biometric attendance sync ──────────────────────
# Auto-fetches in/out punches from the Star Link eTimeOffice cloud and feeds
# them through the same pipeline as an .xls upload. Leave unset to disable the
# sync (the "Sync from eTimeOffice" button + cron return "not configured").
# All values can also be set in-app via AppSetting (etimeoffice_* keys), which
# take precedence over these env vars — mirror of the CRM email-sender pattern.
ETIMEOFFICE_BASE_URL="https://api.etimeoffice.com/api/"
ETIMEOFFICE_CORP_ID=""
ETIMEOFFICE_USERNAME=""
ETIMEOFFICE_PASSWORD=""
# Which employees to pull ("ALL" or a specific biometric code).
ETIMEOFFICE_EMPCODE="ALL"
# Basic-auth composition. VERIFY against your official eTimeOffice API PDF:
#   corp-user-pass (default) → Basic base64(CorpId:Username:Password)
#   user-pass                → Basic base64(Username:Password)
ETIMEOFFICE_AUTH_MODE="corp-user-pass"
# Escape hatches when the auth string differs from the two modes above:
#   ETIMEOFFICE_AUTH_RAW    → this exact string is base64-encoded as the Basic credential
#   ETIMEOFFICE_AUTH_HEADER → used verbatim as the Authorization header (paste from Postman)
ETIMEOFFICE_AUTH_RAW=""
ETIMEOFFICE_AUTH_HEADER=""
# Hard cutover — the sync NEVER touches attendance before this date. Default
# 2026-06-26, the start of the July salary cycle: the sync owns the whole July
# cycle (26 Jun → 25 Jul); the June cycle and earlier .xls data stay untouched.
ETIMEOFFICE_SYNC_FROM="2026-06-26"
# Daily cron re-pulls this many trailing days (to catch late punch edits).
ETIMEOFFICE_SYNC_LOOKBACK_DAYS="10"
# Shared secret for the scheduled sync route (/api/cron/etime-sync). Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`. Unset → cron sync disabled.
CRON_SECRET=""
